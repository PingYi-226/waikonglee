{%- comment -%}
  Research page, funded projects (_data/grants.yml, newest first): rows that open one at a time (disclosure, unfold) to
  role, funder, amount and output. Each row's id is the first five words of its title, slugified: the page's head links
  to it.
{%- endcomment -%}
<section class="rproj rpart" id="projects" aria-labelledby="rproj-title" data-snap data-rproj>
  <div class="wrap rgrid">
    <div class="rgrid__main">
      <header class="sechead" data-inview>
        <h2 class="sechead__title" id="rproj-title">Funded projects</h2>
      </header>
      <ul class="rows rproj__rows" data-kit="highlight" data-items=".rproj__head">
        {%- for g in site.data.grants %}
        {%- assign i = forloop.index0 %}
        {%- assign pid = g.title | slugify | split: '-' | slice: 0, 5 | join: '-' %}
        <li class="rproj__row" id="{{ pid }}">
          <h3 class="rproj__h">
            <button
              type="button"
              class="rproj__head"
              data-kit="disclosure press"
              data-press="choice"
              data-effect="unfold"
              data-group="rproj"
              aria-expanded="false"
              aria-controls="rproj-{{ i }}"
            >
              <span class="rproj__period t-data">{{ g.period }}</span>
              <span class="rproj__title">{{ g.title }}</span>
              <span class="rproj__chev" data-disclosure-icon>{% include site/icon.liquid name="chevron-down" size=18 %}</span>
            </button>
          </h3>
          <div class="rproj__panel" id="rproj-{{ i }}" data-disclosure-panel>
            <dl class="rproj__body">
              <div class="rproj__item"><dt class="t-label">Role</dt><dd>{{ g.role }}</dd></div>
              <div class="rproj__item"><dt class="t-label">Funder</dt><dd>{{ g.funder }}</dd></div>
              <div class="rproj__item"><dt class="t-label">Amount</dt><dd class="rproj__amount">{{ g.amount }}</dd></div>
              <div class="rproj__item rproj__item--wide"><dt class="t-label">Output</dt><dd>{{ g.output }}</dd></div>
            </dl>
          </div>
        </li>
        {%- endfor %}
      </ul>
    </div>
  </div>
</section>
