{%- comment -%}
  Home page, about block (one slide): the lede (the first paragraph of _pages/about.md), the portrait, and the strip of
  education and work from _data/cv.yml on one time axis (positions in percent of the axis, computed here as on the CV page).
  Styles and script: home-about. When the block is first reached the lede is typed where it stands while the portrait
  sways as if speaking (typing-text data-keep, tilt's aim()). Without the script everything is there; a bar's details
  show on hover or focus.
{%- endcomment -%}
<section class="about section" id="about" data-snap data-about aria-labelledby="about-title">
  <div class="wrap about__wrap">
    <header class="sechead" data-inview>
      <h2 class="sechead__title" id="about-title">About</h2>
    </header>

    <div class="about__grid">
      <div class="about__lede" data-kit="typing-text" data-keep data-trigger="manual" data-duration="4.4">
        {{- paras[0] | append: '</p>' -}}
      </div>

      <figure class="about__photo" data-kit="reveal" data-reveal="clip" data-trigger="manual">
        <div class="about__frame" data-kit="tilt hearts" data-max="5" data-shine="true" data-glare>
          <img
            src="{{ '/assets/img/prof_pic.jpg' | relative_url }}"
            alt="Portrait of {{ site.first_name }} {{ site.last_name }}"
            width="339"
            height="418"
          >
        </div>
      </figure>
    </div>

    {%- assign cv = site.data.cv.cv -%}
    {%- assign edu = cv.sections.Education | sort: 'start_date' -%}
    {%- assign work = cv.sections.Experience | sort: 'start_date' -%}
    {%- assign first_edu = edu | first -%}
    {%- assign first_work = work | first -%}
    {%- assign start0 = first_edu.start_date -%}
    {%- if first_work.start_date < start0 -%}{%- assign start0 = first_work.start_date -%}{%- endif -%}
    {%- assign y0 = start0 | slice: 0, 4 | plus: 0 -%}
    {%- assign t0 = y0 | times: 12 -%}
    {%- assign t1 = year_now | times: 12 | plus: month_now -%}
    {%- assign span = t1 | minus: t0 %}
    <div class="strip" data-strip>
      {%- for lane in (1..2) %}
        {%- if lane == 1 -%}
          {%- assign items = edu -%}{%- assign lane_name = 'Education' -%}{%- assign lane_key = 'edu' -%}
        {%- else -%}
          {%- assign items = work -%}{%- assign lane_name = 'Work' -%}{%- assign lane_key = 'work' -%}
        {%- endif %}
      <p class="strip__name t-label" id="strip-{{ lane_key }}">{{ lane_name }}</p>
      <ol class="strip__lane strip__lane--{{ lane_key }}" aria-labelledby="strip-{{ lane_key }}">
        {%- for it in items -%}
          {%- assign sy = it.start_date | slice: 0, 4 | plus: 0 -%}
          {%- assign sm = it.start_date | slice: 5, 2 | plus: 0 -%}
          {%- assign from_label = it.start_date | append: '-01' | date: '%b %Y' -%}
          {%- if it.end_date == 'present' -%}
            {%- assign e = span -%}
            {%- assign to_label = 'present' -%}
          {%- else -%}
            {%- assign ey = it.end_date | slice: 0, 4 | plus: 0 -%}
            {%- assign em = it.end_date | slice: 5, 2 | plus: 0 -%}
            {%- assign e = ey | times: 12 | plus: em | minus: t0 -%}
            {%- assign to_label = it.end_date | append: '-01' | date: '%b %Y' -%}
          {%- endif -%}
          {%- assign s = sy | times: 12 | plus: sm | minus: 1 | minus: t0 -%}
          {%- assign left = s | times: 100.0 | divided_by: span -%}
          {%- assign width = e | minus: s | times: 100.0 | divided_by: span -%}
          {%- if it.position -%}
            {%- assign what = it.position | split: ',' | first -%}
            {%- assign where = it.company -%}
          {%- else -%}
            {%- assign what = it.studyType -%}
            {%- assign where = it.institution -%}
          {%- endif %}
        <li class="strip__seg{% if it.end_date == 'present' %} is-now{% endif %}" style="--l: {{ left | round: 3 }}; --w: {{ width | round: 3 }}">
          <button type="button" class="strip__bar" aria-label="{{ what | escape }}, {{ where | escape }}, {{ from_label }} to {{ to_label }}">
            <span class="strip__fill" aria-hidden="true"><span class="strip__glint"></span></span>
          </button>
          <span class="strip__detail" aria-hidden="true">
            <span class="strip__what">{{ what | escape }}</span>
            <span class="strip__where">{{ where | escape }}</span>
            <span class="strip__when t-data">{{ from_label }} – {{ to_label }}</span>
          </span>
        </li>
        {%- endfor %}
      </ol>
      {%- endfor %}
      <ol class="strip__years t-data" aria-hidden="true">
        {%- for y in (y0..year_now) -%}
          {%- assign yl = y | times: 12 | minus: t0 | times: 100.0 | divided_by: span -%}
          {%- if yl >= 0 -%}
            {%- assign mod = y | modulo: 5 -%}
            <li class="strip__tick{% if mod == 0 %} strip__tick--label{% endif %}" style="--l: {{ yl | round: 3 }}">{% if mod == 0 %}<span>{{ y }}</span>{% endif %}</li>
          {%- endif -%}
        {%- endfor -%}
      </ol>
    </div>
  </div>
</section>
