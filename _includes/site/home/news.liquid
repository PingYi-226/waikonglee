{%- comment -%}
  Home page, news block: one slide of the deck. The newest items written by hand (the ones derived from the publication
  and repository lists, derived: true, stay on the news page), page.announcements.limit of them; a featured item
  (featured: true, until its deadline) comes first, drawn by news_feature.liquid as on the news page.
  Styles and script: home-news and news-feature.
{%- endcomment -%}
{%- assign written = site.news | where_exp: 'item', 'item.derived != true' | sort: 'date' | reverse -%}
{%- assign now_s = site.time | date: '%s' | plus: 0 -%}
{%- assign hn_feats = '' | split: '' -%}
{%- assign hn_rest = '' | split: '' -%}
{%- for item in written -%}
  {%- assign feat = false -%}
  {%- if item.featured == true -%}
    {%- assign feat = true -%}
    {%- if item.deadline -%}
      {%- assign until = item.deadline | date: '%s' | plus: 86400 -%}
      {%- if until < now_s -%}{%- assign feat = false -%}{%- endif -%}
    {%- endif -%}
  {%- endif -%}
  {%- if feat -%}{%- assign hn_feats = hn_feats | push: item -%}{%- else -%}{%- assign hn_rest = hn_rest | push: item -%}{%- endif -%}
{%- endfor -%}
{%- assign hn_items = hn_feats | concat: hn_rest -%}
{%- assign hn_count = hn_feats | size -%}
<section class="hnews section" id="news" data-snap>
  <div class="wrap">
    <header class="sechead" data-inview>
      <h2 class="sechead__title">News</h2>
      <a class="link" href="{{ '/news/' | relative_url }}">All news</a>
    </header>
    <div class="hnews__body" data-kit="reveal-group" data-items="[data-reveal-item]" data-trigger="manual">
    <ol class="hnews__list rows" data-kit="highlight hover-preview" data-mode="hover" data-items=".hnews__row:not(.hnews__row--feature)">
      {%- for item in hn_items limit: page.announcements.limit -%}
        {%- if forloop.index0 < hn_count %}
          <li class="hnews__row hnews__row--feature" data-reveal-item>
            {% include site/news_feature.liquid item=item %}
          </li>
        {%- else %}
          <li
            class="hnews__row"
            data-reveal-item
            {% if item.image %}
              data-preview="{{ item.image | prepend: '/assets/img/' | relative_url }}"
              data-preview-alt="{{ item.image_alt | default: 'News photo' }}"
            {% endif %}
          >
            <p class="hnews__date t-data">
              {%- if item.label %}<span class="hnews__tag tag">{{ item.label }}</span>{% endif -%}
              {%- if item.date_label -%}
                <span>{{ item.date_label }}</span>
              {%- else -%}
                <time datetime="{{ item.date | date_to_xmlschema }}">{{ item.date | date: '%-d %b %Y' }}</time>
              {%- endif -%}
            </p>
            <div class="hnews__text">{{ item.content }}</div>
            {%- if item.image %}
              <img
                class="hnews__thumb"
                src="{{ item.image | prepend: '/assets/img/' | relative_url }}"
                alt="{{ item.image_alt | default: 'News photo' }}"
                loading="lazy"
              >
            {%- endif %}
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ol>
    </div>
  </div>
</section>
