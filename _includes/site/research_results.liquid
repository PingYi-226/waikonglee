{%- comment -%}
  Research page, selected results (_data/highlights.yml): a ruled grid, no cards. Each cell: the figure (rolls to its value
  the first time it is seen), the unit in italic, the sentence, and the paper. One surface glides over the cells.
{%- endcomment -%}
<section class="rres section" id="results" aria-labelledby="rres-title">
  <div class="wrap">
    <header class="sechead" data-inview>
      <h2 class="sechead__title" id="rres-title">Selected results</h2>
    </header>
    <ol class="rres__grid" data-kit="highlight reveal-group" data-mode="hover" data-items=".rres__cell" data-reveal="fade">
      {%- for r in site.data.highlights %}
      <li class="rres__cell" data-reveal-item>
        <p class="rres__figure">
          <span data-kit="sliding-number" data-value="{{ r.value }}"{% if r.suffix %} data-suffix="{{ r.suffix }}"{% endif %} data-delay="120">{{ r.figure }}</span>
        </p>
        <p class="rres__unit">{{ r.unit }}</p>
        <p class="rres__text">{{ r.text }}</p>
        <p class="rres__src">
          <a class="link-arrow" href="https://doi.org/{{ r.doi }}">
            <span>{{ r.name }}, <span class="t-data">{{ r.venue }} {{ r.year }}</span></span>
            {% include site/icon.liquid name="arrow-up-right" size=16 %}
          </a>
        </p>
      </li>
      {%- endfor %}
    </ol>
  </div>
</section>
