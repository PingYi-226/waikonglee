{%- comment -%} Site design layer: loaded after the al-folio core styles so it can refine them. {%- endcomment -%}
{% if site.noindex or page.noindex %}<meta name="robots" content="noindex">{% endif %}
<script>
  // Mark that JavaScript is available so content can start hidden and animate in.
  // If the site script has not started within a few seconds, drop the mark so nothing stays hidden.
  document.documentElement.classList.add('js');
  // The template's theme script marks <html> with "transition" for a moment whenever it applies a theme, also on load;
  // while the mark is there its stylesheet lets only colours transition, which would swallow every entrance that starts
  // in the first third of a second. On load there is nothing to cross-fade, so take the mark off again.
  document.documentElement.classList.remove('transition');
  setTimeout(function () {
    if (!document.documentElement.classList.contains('is-ready')) document.documentElement.classList.remove('js');
  }, 4000);
</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
{%- comment -%} Shared stylesheets first, then the ones the page asks for in its front matter (site_css: [pub, home]). {%- endcomment -%}
{% assign site_css = 'tokens,base,kit-text,kit-pointer,kit-scroll,icons,shell,parts' | split: ',' %}
{% for name in site_css %}
  <link rel="stylesheet" href="{{ '/assets/css/site/' | append: name | append: '.css' | relative_url | bust_file_cache }}">
{% endfor %}
{% for name in page.site_css %}
  <link rel="stylesheet" href="{{ '/assets/css/site/' | append: name | append: '.css' | relative_url | bust_file_cache }}">
{% endfor %}
