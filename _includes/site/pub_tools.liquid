{%- comment -%} Controls for the publication list. The chart and the counts are computed in the browser from the list itself. {%- endcomment -%}
<div class="pubtools" data-pubtools hidden>
  <div class="pubchart" data-pubchart role="group" aria-label="Publications per year"></div>
  <div class="pubfilters">
    <div class="chips" role="group" aria-label="Filter by type">
      <button type="button" class="chip is-active" data-filter-type="all">All</button>
      <button type="button" class="chip" data-filter-type="journal">Journals</button>
      <button type="button" class="chip" data-filter-type="conference">Conferences</button>
    </div>
    <div class="chips" role="group" aria-label="Filter by research area">
      <button type="button" class="chip is-active" data-filter-area="all">All areas</button>
      {% for a in site.data.research %}
        <button type="button" class="chip" data-filter-area="{{ a.key }}">{{ a.short | default: a.title }}</button>
      {% endfor %}
    </div>
    <div class="pubsearch">
      <label class="sr-only" for="pubsearch">Search publications</label>
      <input id="pubsearch" type="search" placeholder="Search by title, author or venue" autocomplete="off" spellcheck="false" data-pubsearch>
      <p class="pubcount" aria-live="polite" data-pubcount></p>
    </div>
  </div>
</div>
<p class="pubempty" data-pubempty hidden>No papers match these filters.</p>
