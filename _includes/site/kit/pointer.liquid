  <script>
    // Demo wiring only: what a page script would do with the kit.
    document.addEventListener("DOMContentLoaded", function () {
      var root = document.getElementById("kit-pointer");
      if (!root) return;
      function pick(group, attr, item) {
        Array.prototype.forEach.call(group.querySelectorAll("[" + attr + "]"), function (other) {
          if (attr === "aria-current") other.removeAttribute(attr);
          else other.setAttribute(attr, "false");
        });
        item.setAttribute(attr, "true");
      }
      root.addEventListener("click", function (e) {
        var chip = e.target.closest("#pd-chips .chip");
        if (chip) pick(chip.parentNode, "aria-pressed", chip);
        var side = e.target.closest("#pd-side a");
        if (side) pick(side.parentNode, "aria-current", side);
        // the demo links go nowhere
        var link = e.target.closest('a[href^="#demo-"]');
        if (link) e.preventDefault();

        // disclosure: a control inside the panel closes it
        var closer = e.target.closest("[data-pd-close]");
        if (closer) Site.get(document.getElementById(closer.getAttribute("data-pd-close")), "disclosure").close();

        // toast
        if (e.target.closest("#pd-toast-one")) Site.toast("Copied BibTeX");
        if (e.target.closest("#pd-toast-three"))
          ["Abstract copied", "Link copied", "Citation copied"].forEach(function (text, i) {
            setTimeout(function () { Site.toast(text); }, i * 350);
          });
        if (e.target.closest("#pd-toast-long")) Site.toast("The preprint was added to your reading list. It will appear in the publications page after the next update.", { duration: 8000 });

        // flip: the short list
        var list = document.getElementById("pd-flip-list");
        var filter = e.target.closest("[data-pd-filter]");
        if (filter) {
          pick(filter.parentNode, "aria-pressed", filter);
          var tag = filter.getAttribute("data-pd-filter");
          Site.flip(list, function () {
            Array.prototype.forEach.call(list.children, function (row) {
              if (row.hasAttribute("data-tags")) row.hidden = tag !== "all" && row.getAttribute("data-tags").split(" ").indexOf(tag) < 0;
            });
          });
        }
        if (e.target.closest("#pd-flip-shuffle"))
          Site.flip(list, function () {
            var rows = Array.prototype.filter.call(list.children, function (row) { return row.hasAttribute("data-tags"); });
            rows.sort(function () { return Math.random() - 0.5; }).forEach(function (row) { list.appendChild(row); });
          });
        if (e.target.closest("#pd-flip-add"))
          Site.flip(list, function () {
            var row = document.createElement("li");
            row.setAttribute("data-tags", "gpu fpga pqc");
            row.innerHTML = '<span>A new preprint, added ' + new Date().toLocaleTimeString() + '</span><span class="t-label">2026</span>';
            list.insertBefore(row, list.children[1] || null);
          });
        if (e.target.closest("#pd-flip-remove"))
          Site.flip(list, function () {
            var first = Array.prototype.filter.call(list.children, function (row) { return row.hasAttribute("data-tags") && !row.hidden; })[0];
            if (first) first.remove();
          });

        // flip: the grid
        var cards = document.getElementById("pd-flip-cards");
        var sort = e.target.closest("#pd-cards-sort");
        if (sort) {
          var up = sort.getAttribute("data-up") !== "true";
          sort.setAttribute("data-up", String(up));
          Site.flip(cards, function () {
            Array.prototype.slice.call(cards.children)
              .sort(function (a, b) { return (a.getAttribute("data-year") - b.getAttribute("data-year")) * (up ? 1 : -1); })
              .forEach(function (card) { cards.appendChild(card); });
          });
        }
        var only = e.target.closest("#pd-cards-filter");
        if (only) {
          var on = only.getAttribute("aria-pressed") !== "true";
          only.setAttribute("aria-pressed", String(on));
          Site.flip(cards, function () {
            Array.prototype.forEach.call(cards.children, function (card) { card.hidden = on && card.getAttribute("data-kind") !== "journal"; });
          });
        }

        // flip: the long list
        var long = document.getElementById("pd-flip-long");
        var longFilter = e.target.closest("[data-pd-long]");
        if (longFilter) {
          pick(longFilter.parentNode, "aria-pressed", longFilter);
          var rule = longFilter.getAttribute("data-pd-long");
          Site.flip(long, function () {
            Array.prototype.forEach.call(long.children, function (row) {
              var n = Number(row.getAttribute("data-n"));
              if (n) row.hidden = rule === "late" ? n <= 70 : rule !== "all" && n % Number(rule) !== 0;
            });
          });
        }
      });
    });
  </script>
</section>
