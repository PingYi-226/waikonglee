    <circle class="dg-s dg-p" style="--k: 6" cx="132" cy="66" r="0.71" fill="currentColor"/>
    <circle class="dg-s dg-p" style="--k: 2" cx="52" cy="82" r="0.89" fill="currentColor"/>
    <circle class="dg-s dg-p" style="--k: 3" cx="68" cy="82" r="1.33" fill="currentColor"/>
    <circle class="dg-s dg-p" style="--k: 4" cx="84" cy="82" r="2.33" fill="currentColor"/>
    <circle class="dg-s dg-p" style="--k: 5" cx="100" cy="82" r="2.64" fill="currentColor"/>
    <circle class="dg-s dg-p" style="--k: 6" cx="116" cy="82" r="1.48" fill="currentColor"/>
    <circle class="dg-s dg-p" style="--k: 7" cx="132" cy="82" r="0.94" fill="currentColor"/>
