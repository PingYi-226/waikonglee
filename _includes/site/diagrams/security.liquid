{%- comment -%}
  Quantum cryptanalysis: Grover's search on three qubits. Wires start in |0>, Hadamards (H) spread the amplitude evenly,
  the oracle block flips the sign of the marked state, the diffusion block inverts every amplitude about the mean, and
  the qubits are measured. Beside the circuit, the eight amplitudes as bars on a zero line; after one iteration the
  marked state (accent) holds 0.88 and each other state 0.18 (bar height 70 per unit).
  Live: a marker passes along the wires; the bars even out at the Hadamards, the marked one dips below zero at the
  oracle, the mean shows, and the bars turn about it at the diffusion; then it rests (diagrams.js, SCENES.security).
  Parameters: live (hover | always | off), trigger (view | manual), detail ("full" shows the labels), class.
{%- endcomment -%}
<svg class="diagram diagram--security{% if include.class %} {{ include.class }}{% endif %}" viewBox="0 0 320 180" data-kit="diagram" data-live="{{ include.live | default: 'hover' }}" data-trigger="{{ include.trigger | default: 'view' }}"{% if include.detail == 'full' %} data-detail="full"{% endif %} role="img" aria-label="A three-qubit quantum circuit with Hadamard gates, an oracle and a diffusion block, beside eight amplitude bars in which the marked state's bar has grown." fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
  {%- comment -%} the wires {%- endcomment %}
  <g class="dg-h" style="--t: 0">
    <path class="dg-d" pathLength="1" d="M40 58H160"/>
    <path class="dg-d" style="--k: 3" pathLength="1" d="M40 90H160"/>
    <path class="dg-d" style="--k: 6" pathLength="1" d="M40 122H160"/>
  </g>
  {%- comment -%} Hadamards, the oracle, the diffusion, the measurements {%- endcomment %}
  <g style="--t: 0.2">
    <rect class="dg-k dg-d" pathLength="1" x="51" y="51" width="14" height="14" rx="1.5"/>
    <rect class="dg-k dg-d" style="--k: 2" pathLength="1" x="51" y="83" width="14" height="14" rx="1.5"/>
    <rect class="dg-k dg-d" style="--k: 4" pathLength="1" x="51" y="115" width="14" height="14" rx="1.5"/>
  </g>
  <rect class="dg-k dg-d" style="--t: 0.36" pathLength="1" x="82" y="46" width="24" height="88" rx="2"/>
  <rect class="dg-k dg-d" style="--t: 0.46" pathLength="1" x="120" y="46" width="24" height="88" rx="2"/>
  <g style="--t: 0.56">
    <rect class="dg-k dg-d" pathLength="1" x="160" y="51" width="16" height="13" rx="1.5"/>
    <path class="dg-m dg-d" style="--k: 2" pathLength="1" d="M163 61.5A5 5 0 0 1 173 61.5M168 61.5L171.5 55"/>
    <rect class="dg-k dg-d" style="--k: 2" pathLength="1" x="160" y="83" width="16" height="13" rx="1.5"/>
    <path class="dg-m dg-d" style="--k: 4" pathLength="1" d="M163 93.5A5 5 0 0 1 173 93.5M168 93.5L171.5 87"/>
    <rect class="dg-k dg-d" style="--k: 4" pathLength="1" x="160" y="115" width="16" height="13" rx="1.5"/>
    <path class="dg-m dg-d" style="--k: 6" pathLength="1" d="M163 125.5A5 5 0 0 1 173 125.5M168 125.5L171.5 119"/>
  </g>
  {%- comment -%} the amplitudes: the zero line, the mean (live only), one bar per basis state {%- endcomment %}
  <path class="dg-h dg-d" style="--t: 0.3" pathLength="1" d="M194 112H280"/>
  <path class="dg-m dg-x" data-dg="mean" d="M194 93.44H280" stroke-dasharray="2 3" opacity="0"/>
  <g style="--t: 0.5">
    <rect class="dg-s dg-g" data-dg="bar" data-a="0.18" x="199" y="99.62" width="6" height="12.38" fill="currentColor" fill-opacity="0.45"/>
    <rect class="dg-s dg-g" data-dg="bar" data-a="0.18" style="--k: 2" x="209" y="99.62" width="6" height="12.38" fill="currentColor" fill-opacity="0.45"/>
    <rect class="dg-s dg-g" data-dg="bar" data-a="0.18" style="--k: 4" x="219" y="99.62" width="6" height="12.38" fill="currentColor" fill-opacity="0.45"/>
    <rect class="dg-s dg-g" data-dg="bar" data-a="0.18" style="--k: 6" x="229" y="99.62" width="6" height="12.38" fill="currentColor" fill-opacity="0.45"/>
    <rect class="dg-s dg-g" data-dg="bar" data-a="0.18" style="--k: 8" x="239" y="99.62" width="6" height="12.38" fill="currentColor" fill-opacity="0.45"/>
    <rect class="dg-sa dg-g" data-dg="bar" data-a="0.88" style="--t: 0.4; --k: 14" x="249" y="50.13" width="6" height="61.87" fill="currentColor"/>
    <rect class="dg-s dg-g" data-dg="bar" data-a="0.18" style="--k: 12" x="259" y="99.62" width="6" height="12.38" fill="currentColor" fill-opacity="0.45"/>
    <rect class="dg-s dg-g" data-dg="bar" data-a="0.18" style="--k: 14" x="269" y="99.62" width="6" height="12.38" fill="currentColor" fill-opacity="0.45"/>
  </g>
  {%- comment -%} live only: the marker passing along the wires {%- endcomment %}
  <g data-dg="marker" data-x="58" opacity="0" class="dg-x">
    <path class="dg-m" d="M58 42V138"/>
  </g>
  {%- if include.detail == 'full' %}
  <g class="dg-f" style="--t: 1">
    <text class="dg-sym" x="36" y="62" text-anchor="end">|0⟩</text>
    <text class="dg-gate" x="58" y="61.5" text-anchor="middle">H</text>
    <text class="dg-sym" x="36" y="94" text-anchor="end">|0⟩</text>
    <text class="dg-gate" x="58" y="93.5" text-anchor="middle">H</text>
    <text class="dg-sym" x="36" y="126" text-anchor="end">|0⟩</text>
    <text class="dg-gate" x="58" y="125.5" text-anchor="middle">H</text>
    <text class="dg-sym" x="94" y="94" text-anchor="middle">U<tspan class="dg-sub" dy="2.5">ω</tspan></text>
    <text class="dg-sym" x="132" y="94" text-anchor="middle">U<tspan class="dg-sub" dy="2.5">s</tspan></text>
    <text class="dg-sym" x="252" y="126" text-anchor="middle">ω</text>
  </g>
  {%- endif %}
</svg>
