{%- comment -%}
  Deep-learning hardware: a 3 x 3 convolution window over a 6 x 6 feature map (dots sized by activation, a diagonal
  band), writing a 4 x 4 output map; the cell being written carries the accent, the cells already written show their
  response (the kernel answers the diagonal). At rest the window is at step 5 of 16.
  Live: the window steps across the map, one output per beat (diagrams.js, SCENES.ml).
  Parameters: live (hover | always | off), trigger (view | manual), detail ("full" shows the labels), class.
{%- endcomment -%}
<svg class="diagram diagram--ml{% if include.class %} {{ include.class }}{% endif %}" viewBox="0 0 320 180" data-kit="diagram" data-live="{{ include.live | default: 'hover' }}" data-trigger="{{ include.trigger | default: 'view' }}"{% if include.detail == 'full' %} data-detail="full"{% endif %} role="img" aria-label="A three by three kernel window slides over a feature map, and each position writes one cell of the output map." fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
  {%- comment -%} the two maps {%- endcomment %}
  <g class="dg-h" style="--t: 0">
    <rect class="dg-d" pathLength="1" x="44" y="42" width="96" height="96"/>
    <rect class="dg-d" style="--k: 4" pathLength="1" x="212" y="58" width="64" height="64"/>
  </g>
  <g class="dg-h" stroke-opacity="0.22" style="--t: 0.1">
    <path class="dg-d" pathLength="1" d="M60 42V138M44 58H140M76 42V138M44 74H140M92 42V138M44 90H140M108 42V138M44 106H140M124 42V138M44 122H140"/>
    <path class="dg-d" style="--k: 4" pathLength="1" d="M228 58V122M212 74H276M244 58V122M212 90H276M260 58V122M212 106H276"/>
  </g>
  {%- comment -%} the feature map: one dot per value {%- endcomment %}
  <g style="--t: 0.22">
    <circle class="dg-s dg-p" cx="52" cy="50" r="2.33" fill="currentColor"/>
    <circle class="dg-s dg-p" style="--k: 1" cx="68" cy="50" r="2.64" fill="currentColor"/>
    <circle class="dg-s dg-p" style="--k: 2" cx="84" cy="50" r="1.48" fill="currentColor"/>
    <circle class="dg-s dg-p" style="--k: 3" cx="100" cy="50" r="0.94" fill="currentColor"/>
    <circle class="dg-s dg-p" style="--k: 4" cx="116" cy="50" r="0.71" fill="currentColor"/>
    <circle class="dg-s dg-p" style="--k: 5" cx="132" cy="50" r="0.6" fill="currentColor"/>
    <circle class="dg-s dg-p" style="--k: 1" cx="52" cy="66" r="1.33" fill="currentColor"/>
    <circle class="dg-s dg-p" style="--k: 2" cx="68" cy="66" r="2.33" fill="currentColor"/>
    <circle class="dg-s dg-p" style="--k: 3" cx="84" cy="66" r="2.64" fill="currentColor"/>
    <circle class="dg-s dg-p" style="--k: 4" cx="100" cy="66" r="1.48" fill="currentColor"/>
