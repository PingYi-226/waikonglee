{%- comment -%}
  Home page, first screen: the name, the role, the statement, two buttons, the key figures, and the lattice behind them.
  Styles and script: home-hero. The canvas sits outside the section on purpose: it is a fixed layer under the first
  screen, and the stepper moves the section itself (a translate there would carry a fixed child along).
  Without the script everything is there and still; the canvas stays empty.
{%- endcomment -%}
<canvas class="hero-lattice" data-lattice aria-hidden="true"></canvas>
<section class="hero" data-hero data-snap aria-labelledby="hero-name">
  <div class="hero__main">
    <h1 class="hero__name t-hero" id="hero-name" data-hero-name aria-label="{{ site.first_name }} {{ site.last_name }}">
      <span class="hero__line" aria-hidden="true">{{ site.first_name }}</span>
      <span class="hero__line" aria-hidden="true">{{ site.last_name }}</span>
    </h1>

    <div class="hero__copy">
      <p class="hero__role" data-kit="split" data-split="words" data-effect="arrive" data-trigger="manual" data-stagger="0.03" data-hero-rank="1">
        {{- profile.role }}, {{ profile.affiliation -}}
      </p>

      {%- comment -%} The last words of the statement melt into one another. Without the script the whole sentence is there. {%- endcomment -%}
      {%- capture rotate_words -%}
        {%- for w in profile.statement_rotate -%}{{ w }}.{% unless forloop.last %}|{% endunless %}{%- endfor -%}
      {%- endcapture -%}
      {%- assign rotate_words = rotate_words | strip | split: '|' -%}
      <p class="hero__statement" data-kit="split" data-split="words" data-effect="arrive" data-trigger="manual" data-stagger="0.028" data-hero-rank="2">
        {{ profile.statement_lead }}
        <span class="hero__rotate" data-kit="morph-text" data-words='{{ rotate_words | jsonify }}' data-trigger="manual">
          {{- profile.statement_tail -}}.
        </span>
      </p>

      <div class="hero__actions">
        <a class="btn" href="{{ '/publications/' | relative_url }}" data-kit="reveal magnetic press ripple" data-reveal="wipe" data-trigger="manual" data-inner data-hero-rank="3">
          <span data-kit="sliding-text">Publications</span>
          {% include site/icon.liquid name="arrow-right" size=18 %}
        </a>
        <a class="btn btn--ghost" href="{{ '/research/' | relative_url }}" data-kit="reveal magnetic press ripple" data-reveal="wipe" data-trigger="manual" data-inner data-hero-rank="4">
          <span data-kit="sliding-text">Research</span>
          {% include site/icon.liquid name="arrow-right" size=18 %}
        </a>
      </div>
    </div>
  </div>

  <div class="hero__base" data-hero-rank="5">
    <dl class="hero__figures">
      <div class="stat">
        <dt class="stat__label">peer-reviewed papers</dt>
        <dd class="stat__value"><span data-kit="sliding-number" data-trigger="manual" data-value="{% bibliography_count %}">{% bibliography_count %}</span></dd>
      </div>
      <div class="stat">
        <dt class="stat__label">citations</dt>
        <dd class="stat__value">
          {%- if profile.metrics.source_url -%}
            <a class="hero__cite" href="{{ profile.metrics.source_url }}"><span data-kit="sliding-number" data-trigger="manual" data-value="{{ profile.metrics.citations | remove: ',' }}">{{ profile.metrics.citations }}</span></a>
          {%- else -%}
            <span data-kit="sliding-number" data-trigger="manual" data-value="{{ profile.metrics.citations | remove: ',' }}">{{ profile.metrics.citations }}</span>
          {%- endif -%}
        </dd>
      </div>
      <div class="stat">
        <dt class="stat__label">h-index</dt>
        <dd class="stat__value"><span data-kit="sliding-number" data-trigger="manual" data-value="{{ profile.metrics.h_index }}">{{ profile.metrics.h_index }}</span></dd>
      </div>
    </dl>
  </div>
</section>
