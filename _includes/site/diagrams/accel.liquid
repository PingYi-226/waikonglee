    <path class="dg-d" style="--k: 5" pathLength="1" d="M54 90H166"/>
    <path class="dg-d" style="--k: 7" pathLength="1" d="M54 118H166"/>
  </g>
  {%- comment -%} the bytes, row by row: column 0 solid, the rest faint; three copies of each row for the wrap {%- endcomment %}
  <g style="--t: 0.3">
    <svg x="54" y="34" width="112" height="28" viewBox="54 34 112 28">
      <g data-dg="row" data-r="0">
        <circle class="dg-s dg-p" cx="68" cy="48" r="3" fill="currentColor"/>
