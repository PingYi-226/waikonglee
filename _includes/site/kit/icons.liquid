<section class="kitdemo" id="kit-icons">
  <h2 class="t-d2">icons</h2>

  <article class="kitdemo__item" id="demo-icons">
    <header>
      <h3>icon set</h3>
      <p>Hover a button, or Tab to it: each icon moves like its object. One include, 24 px grid, 1.5 px strokes.</p>
    </header>
    <div class="kitdemo__stage">
      <ul class="kiticons">
        {%- assign demo_icons = "arrow-right,arrow-up-right,external,arrow-down,arrow-up,chevron-down,chevron-right,copy,check,search,menu,close,sun,moon,mail,github,scholar,orcid,scopus,download,file-text,code,quote,link,map-pin,clock,plus,minus,play,pause,zoom" | split: "," -%}
        {%- for n in demo_icons %}
        <li><button type="button" class="icon-btn" aria-label="{{ n }}" id="icon-{{ n }}">{% include site/icon.liquid name=n %}</button><span class="t-label">{{ n }}</span></li>
        {%- endfor %}
      </ul>
    </div>
  </article>

  <article class="kitdemo__item" id="demo-icon-links">
    <header>
      <h3>icons in links and buttons</h3>
      <p>The icon plays when its closest link, button or [data-icon-trigger] is hovered or focused. The menu button turns its bars into a cross with aria-expanded.</p>
    </header>
    <div class="kitdemo__stage stack" style="--stack: 1.25rem">
      <div class="cluster">
        <a class="btn" href="#demo-icon-links" id="il-cv">Download CV {% include site/icon.liquid name="download" size="18" %}</a>
        <a class="btn btn--ghost" href="#demo-icon-links" id="il-pubs">All publications {% include site/icon.liquid name="arrow-right" size="18" %}</a>
        <a class="link" href="#demo-icon-links" id="il-doi">doi.org/10.1109/TC.2024.3359 {% include site/icon.liquid name="external" size="1em" %}</a>
      </div>
      <div class="cluster">
        <a class="btn btn--ghost btn--small" href="#demo-icon-links" id="il-mail">{% include site/icon.liquid name="mail" size="16" %} Email</a>
        <a class="btn btn--ghost btn--small" href="#demo-icon-links">{% include site/icon.liquid name="scholar" size="16" %} Google Scholar</a>
        <a class="btn btn--ghost btn--small" href="#demo-icon-links">{% include site/icon.liquid name="orcid" size="16" %} ORCID</a>
        <a class="btn btn--ghost btn--small" href="#demo-icon-links">{% include site/icon.liquid name="github" size="16" %} GitHub</a>
      </div>
      <div class="card" style="padding: 1.25rem 1.4rem; max-width: 30rem" data-icon-trigger tabindex="0" id="il-card">
        <p class="t-label">Card with data-icon-trigger</p>
        <p style="margin: 0.4rem 0 0">GPU-accelerated NTT for CKKS bootstrapping {% include site/icon.liquid name="arrow-up-right" size="1em" %}</p>
      </div>
      <div class="cluster">
        <button type="button" class="icon-btn" aria-label="Menu" aria-expanded="false" id="il-menu" onclick="this.setAttribute('aria-expanded', this.getAttribute('aria-expanded') === 'true' ? 'false' : 'true')">{% include site/icon.liquid name="menu" %}</button>
        <span class="t-muted t-small">aria-expanded toggles the cross</span>
      </div>
    </div>
  </article>

  <article class="kitdemo__item" id="demo-icon-swap">
    <header>
      <h3>Site.icons.swap</h3>
      <p>One icon swapping for another in place: out to half size through a light blur, the next one out of it. The theme button turns as it swaps (spin).</p>
    </header>
    <div class="kitdemo__stage cluster" style="--cluster: 1.5rem">
      <button type="button" class="btn btn--ghost btn--small" id="swap-copy" data-demo-swap="copy">{% include site/icon.liquid name="copy" size="16" %} Copy BibTeX</button>
      <button type="button" class="icon-btn" id="swap-theme" aria-label="Switch theme" data-demo-swap="theme">{% include site/icon.liquid name="sun" %}</button>
      <button type="button" class="icon-btn" id="swap-play" aria-label="Pause" data-demo-swap="play">{% include site/icon.liquid name="pause" %}</button>
    </div>
  </article>
</section>
<style>
  .kiticons { display: grid; grid-template-columns: repeat(auto-fill, minmax(6.5rem, 1fr)); gap: 1rem 0.5rem; margin: 0; padding: 0; list-style: none; }
  .kiticons li { display: flex; flex-direction: column; align-items: center; gap: 0.25rem; }
  .kiticons .t-label { font-size: 0.6rem; letter-spacing: 0.06em; }
</style>
<script>
  document.addEventListener("click", function (e) {
    var b = e.target.closest("[data-demo-swap]");
    if (!b || !window.Site || !Site.icons) return;
    var k = b.dataset.demoSwap;
    if (k === "copy") {
      Site.icons.swap(b, "check");
      Site.announce("Copied");
      clearTimeout(b._t);
      b._t = setTimeout(function () { Site.icons.swap(b, "copy"); }, 2000);
    } else if (k === "theme") {
      var dark = b.querySelector(".icon:not(.is-leaving)").classList.contains("icon--sun");
      Site.icons.swap(b, dark ? "moon" : "sun", { spin: true });
    } else if (k === "play") {
      var playing = b.querySelector(".icon:not(.is-leaving)").classList.contains("icon--pause");
      Site.icons.swap(b, playing ? "play" : "pause");
      b.setAttribute("aria-label", playing ? "Play" : "Pause");
    }
  });
</script>
