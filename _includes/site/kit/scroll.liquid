<style>
  .ks-note { margin-top: 1rem; font-size: var(--fs-xs); color: var(--muted); }
  .ks-row { display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center; }
  .ks-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr)); gap: 1rem; margin-top: 1.5rem; }
  .ks-card { display: block; padding: 1.25rem; }
  .ks-card h5 { font-family: var(--font-display); font-size: var(--fs-d4); line-height: 1.2; margin: 0.4rem 0 0.6rem; }
  .ks-card p { font-size: var(--fs-small); color: var(--muted); margin: 0; }
  .ks-media { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 1.5rem; }
  .ks-media figure { margin: 0; overflow: hidden; border-radius: var(--r-3); }
  .ks-media img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .ks-rows { list-style: none; margin: 1.5rem 0 0; padding: 0; border-top: 1px solid var(--line); }
  .ks-rows li { display: flex; gap: 1rem; padding: 0.85rem 0; border-bottom: 1px solid var(--line); font-size: var(--fs-small); }
  .ks-rows .t-mono { color: var(--muted); min-width: 3rem; }
  .ks-tall { position: relative; min-height: 150vh; }
  .ks-sticky { position: sticky; top: 20vh; }
  .ks-track { height: 2px; background: var(--line); overflow: hidden; margin: 0.5rem 0 1.5rem; }
  .ks-parallax { position: relative; height: 120vh; display: grid; place-items: center; overflow: hidden; border-radius: var(--r-3); background: var(--paper-2); }
  .ks-parallax img { width: min(70%, 34rem); border-radius: var(--r-3); box-shadow: var(--shadow-2); }
  .ks-parallax .ks-num { position: absolute; right: 8%; top: 22%; font-family: var(--font-display); font-size: var(--fs-d1); color: var(--accent); }
  .ks-parallax .ks-cap { position: absolute; left: 8%; bottom: 24%; }
  .ks-scrub { padding-block: 30vh; }
  .ks-scrub p { font-family: var(--font-display); font-size: var(--fs-d3); line-height: 1.3; max-width: 32ch; }
  .ks-strip { font-family: var(--font-display); font-size: var(--fs-d3); color: var(--ink-2); }
  .ks-strip span { white-space: nowrap; }
  .ks-strip i { font-style: normal; color: var(--faint); }
  .ks-pin-head { display: flex; justify-content: space-between; align-items: end; gap: 1rem; margin-bottom: 1.5rem; }
  .ks-pin-card { width: min(22rem, 78vw); padding: 1.5rem; }
  .ks-pin-card img { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; border-radius: var(--r-2); margin-bottom: 1rem; }
  .ks-pin-card h5 { font-family: var(--font-display); font-size: var(--fs-d4); margin: 0.3rem 0 0.5rem; }
  .ks-pin-card p { font-size: var(--fs-small); color: var(--muted); margin: 0; }
  .ks-pin-card { transition: border-color var(--t-color); }
  .ks-pin-card.is-current { border-color: var(--line-strong); }
  .ks-pin-bar { width: 8rem; height: 2px; background: var(--line); overflow: hidden; }
  .ks-spy { display: grid; grid-template-columns: 10rem minmax(0, 1fr); gap: 2rem; }
  .ks-spy nav { position: sticky; top: 2rem; align-self: start; }
  .ks-spy nav ul { list-style: none; margin: 0; padding: 0; }
  .ks-spy nav a { position: relative; display: block; padding: 0.35rem 0.75rem; font-size: var(--fs-small); color: var(--muted); border-radius: var(--r-2); transition: color var(--t-color); }
  .ks-spy nav a[aria-current="true"] { color: var(--ink); }
  .ks-spy nav a[aria-current="true"]::before { content: ""; position: absolute; left: 0; top: 50%; width: 3px; height: 1rem; margin-top: -0.5rem; border-radius: 2px; background: var(--accent); }
  .ks-spy section { min-height: 60vh; padding: 1rem 0 2rem; border-top: 1px solid var(--line); }
  .ks-fadebox { height: 16rem; overflow-y: auto; padding-right: 0.5rem; }
  .ks-fadebox ol { list-style: none; margin: 0; padding: 0; }
  .ks-fadebox li { padding: 0.7rem 0; border-bottom: 1px solid var(--line); font-size: var(--fs-small); }
  .ks-chips { display: flex; gap: 0.5rem; overflow-x: auto; margin-top: 1.5rem; padding-bottom: 0.25rem; scrollbar-width: none; }
  .ks-chips .chip { flex: 0 0 auto; }
  .ks-draws { display: grid; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); gap: 1.5rem; }
  .ks-draws svg { width: 100%; height: auto; color: var(--accent); }
  .ks-draw-link { display: inline-flex; flex-direction: column; gap: 0.1rem; font-family: var(--font-display); font-size: var(--fs-d4); }
  .ks-draw-link svg { width: 100%; height: 0.6rem; color: var(--accent); overflow: visible; }
  .ks-timeline { position: relative; min-height: 110vh; padding: 10vh 0 10vh 4rem; display: grid; }
  .ks-timeline svg { position: absolute; left: 0.75rem; top: 10vh; width: 1.5rem; height: calc(100% - 20vh); color: var(--accent); }
  .ks-timeline ol { list-style: none; margin: 0; padding: 0; display: grid; align-content: space-between; }
  .ks-timeline li { font-size: var(--fs-small); }
  .ks-timeline b { display: block; font-family: var(--font-display); font-weight: 400; font-size: var(--fs-d4); }
  .ks-ah { padding: 1.25rem; max-width: 36rem; }
  .ks-tilt-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: 1.25rem; }
  .ks-tilt-card { padding: 1.5rem; min-height: 12rem; display: flex; flex-direction: column; justify-content: space-between; }
  .kitdemo a.ks-tilt-card--ink { background: var(--ink); color: var(--paper); border-color: transparent; }
  .ks-tilt-card--ink span { color: inherit; }
  .ks-tiles { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .ks-tiles a { display: block; overflow: hidden; border-radius: var(--r-3); }
  .ks-wipe-pic { margin: 0 0 0 1rem; width: 9rem; border-radius: var(--r-2); overflow: hidden; }
  .ks-wipe-pic img { display: block; width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .ks-seq .t-d4 { display: inline-block; font-family: var(--font-display); }
  .ks-banners { position: relative; height: 15rem; margin-top: 1.5rem; overflow: hidden; border-radius: var(--r-3); background: var(--paper-2); }
  .ks-banner { position: absolute; left: -10%; width: 120%; padding-block: 0.7rem; font-family: var(--font-display); font-size: var(--fs-d4); color: var(--ink-2); background: var(--surface); border-block: 1px solid var(--line); }
  .ks-banner--a { top: 3.2rem; transform: rotate(-5deg); }
  .ks-banner--b { top: 8.6rem; transform: rotate(4deg); }
  .ks-tiles img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .ks-cursor-zone { position: relative; overflow: hidden; border-radius: var(--r-3); }
  .ks-cursor-zone .btn { position: absolute; right: 0.75rem; bottom: 0.75rem; }
  .ks-cursor-field { font: inherit; font-size: var(--fs-small); padding: 0.55rem 0.8rem; border: 1px solid var(--line-strong); border-radius: var(--r-2); background: var(--surface); color: var(--ink); }
  .ks-cursor-none { padding: 0.55rem 0.8rem; border: 1px dashed var(--line-strong); border-radius: var(--r-2); font-size: var(--fs-small); color: var(--muted); }
  .ks-plist { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .ks-plist a { display: grid; grid-template-columns: 4rem minmax(0, 1fr) auto; gap: 1rem; align-items: baseline; padding: 1.1rem 0.25rem; border-bottom: 1px solid var(--line); transition: color var(--t-color); }
  .ks-plist .t-mono { color: var(--muted); }
  .ks-plist b { font-family: var(--font-display); font-weight: 400; font-size: var(--fs-d4); }
  @media (hover: hover) and (pointer: fine) { .ks-plist:hover a:not(:hover) { color: var(--muted); } }
  @media (max-width: 760px) {
    .ks-spy { grid-template-columns: 1fr; }
    .ks-spy nav { position: static; }
    .ks-media, .ks-tiles { grid-template-columns: 1fr; }
    .ks-plist a { grid-template-columns: 3rem minmax(0, 1fr); }
    .ks-plist a > :last-child { display: none; }
  }
</style>

<section class="kitdemo" id="kit-scroll">
  <h2 class="t-d2">Scroll and follow</h2>

  <article class="kitdemo__item" id="demo-snap">
    <header>
      <h3>snap (Site.snap)</h3>
      <p>The scroll stepper needs a page of its own: sections as stops, a pinned section with points and a hold, a section taller than the screen, the footer at the end.</p>
    </header>
    <div class="kitdemo__stage">
      <a class="btn btn--ghost" href="{{ '/kit/snap/' | relative_url }}" data-kit="magnetic press" data-inner><span data-kit="sliding-text">Open the stepper demo</span></a>
    </div>
  </article>

  <article class="kitdemo__item" id="demo-reveal">
    <header>
      <h3>reveal, reveal-group</h3>
      <p>Scroll to it: what enters together cascades in reading order. Tab into a card to play it at once. Replay hides everything again.</p>
    </header>
    <div class="kitdemo__stage">
      <p class="t-label" data-kit="reveal" data-reveal="fade">Selected research</p>
      <h4 class="t-d3" data-kit="reveal">Fast, side-channel aware cryptography on GPUs and embedded processors.</h4>
      <div class="ks-cards" data-kit="reveal-group" data-reveal="card">
        <a class="card ks-card" href="#demo-reveal"><span class="tag tag--accent">GPU</span><h5>Homomorphic encryption at memory speed</h5><p>Bootstrapping kernels that keep the GPU busy.</p></a>
        <a class="card ks-card" href="#demo-reveal"><span class="tag">PQC</span><h5>Lattice schemes on microcontrollers</h5><p>Kyber and Dilithium in a few kilobytes of RAM.</p></a>
        <a class="card ks-card" href="#demo-reveal"><span class="tag">FPGA</span><h5>Number-theoretic transforms in hardware</h5><p>Pipelined NTT cores for large polynomials.</p></a>
        <a class="card ks-card" href="#demo-reveal"><span class="tag tag--clay">ML</span><h5>Private inference</h5><p>Neural networks evaluated on encrypted data.</p></a>
      </div>
      <div class="ks-media">
        <figure data-kit="reveal" data-reveal="clip"><img src="{{ ph1 }}" alt="Placeholder: a lattice of points"></figure>
        <figure data-kit="reveal" data-reveal="zoom"><img src="{{ ph2 }}" alt="Placeholder: a grid of GPU cores"></figure>
      </div>
      <ol class="ks-rows" data-kit="reveal-group" data-reveal="rise">
        <li><span class="t-mono">2026</span>Accelerating CKKS bootstrapping on a single GPU</li>
        <li><span class="t-mono">2025</span>Compact Kyber for 32-bit microcontrollers</li>
        <li><span class="t-mono">2025</span>Batch verification of Dilithium signatures on GPUs</li>
        <li><span class="t-mono">2024</span>A pipelined NTT engine for FPGA</li>
        <li><span class="t-mono">2024</span>Masked AES on RISC-V with vector extensions</li>
        <li><span class="t-mono">2023</span>Parallel Falcon signing on graphics processors</li>
        <li><span class="t-mono">2023</span>Lightweight ciphers for IoT, revisited</li>
        <li><span class="t-mono">2022</span>Fast polynomial multiplication with tensor cores</li>
        <li><span class="t-mono">2022</span>Chaos-based image encryption, a critical look</li>
        <li><span class="t-mono">2021</span>Binarised neural networks on embedded GPUs</li>
        <li><span class="t-mono">2021</span>SIKE on ARMv8, constant time</li>
        <li><span class="t-mono">2020</span>Tensor-core accelerated matrix multiplication for cryptography</li>
      </ol>
      <p class="ks-note"><button type="button" class="btn btn--ghost btn--small" onclick="document.querySelectorAll('#demo-reveal [data-kit~=reveal]').forEach(function(e){Site.get(e,'reveal').reset()});document.querySelectorAll('#demo-reveal [data-kit~=reveal-group]').forEach(function(e){Site.get(e,'reveal-group').reset()})">Replay</button></p>
    </div>
  </article>

  <article class="kitdemo__item" id="demo-wipe">
    <header>
      <h3>reveal: wipe, manual</h3>
      <p>A block sweeps across and the thing is there when it has passed: buttons, a heading, a picture. The second row waits for its page: <code>data-trigger="manual"</code>, played here 80 ms apart.</p>
    </header>
    <div class="kitdemo__stage">
      <h4 class="t-d3" data-kit="reveal" data-reveal="wipe" style="display:inline-block">Cryptographic engineering</h4>
      <div class="ks-row" style="margin-top:1.25rem">
        <a class="btn" href="#demo-wipe" data-kit="reveal magnetic press ripple" data-reveal="wipe" data-inner style="--k-wipe-color: var(--accent)"><span data-kit="sliding-text">Publications</span></a>
        <a class="btn btn--ghost" href="#demo-wipe" data-kit="reveal magnetic press" data-reveal="wipe" data-delay="80" data-inner><span data-kit="sliding-text">Research</span></a>
        <figure class="ks-wipe-pic" data-kit="reveal" data-reveal="wipe" data-delay="160"><img src="{{ ph1 }}" alt="Placeholder: a lattice of points"></figure>
      </div>
      <div class="ks-row ks-seq" style="margin-top:1.5rem">
        <span class="t-d4" data-kit="reveal" data-reveal="wipe" data-trigger="manual">Name</span>
        <span class="t-d4" data-kit="reveal" data-reveal="wipe" data-trigger="manual" data-fallback="false">role</span>
        <span class="t-d4" data-kit="reveal" data-reveal="wipe" data-trigger="manual" data-fallback="false">statement</span>
      </div>
      <p class="ks-note ks-row">
        <button type="button" class="btn btn--ghost btn--small" onclick="document.querySelectorAll('#demo-wipe [data-kit~=reveal]:not([data-trigger])').forEach(function(e){var r=Site.get(e,'reveal');r.reset();r.play()})">Replay</button>
        <button type="button" class="btn btn--small" data-kit="press" onclick="document.querySelectorAll('#demo-wipe .ks-seq [data-kit~=reveal]').forEach(function(e,i){var r=Site.get(e,'reveal');r.reset();setTimeout(function(){r.play()},i*80)})">Play the sequence</button>
      </p>
    </div>
  </article>

  <article class="kitdemo__item" id="demo-scroll-progress">
    <header>
      <h3>scroll-progress</h3>
      <p>Two bars reading <code>--progress</code>: the page's scroll, and this tall block's passage through the viewport.</p>
    </header>
    <div class="kitdemo__stage ks-tall" id="ks-passage">
      <div class="ks-sticky">
        <p class="t-label">Page</p>
        <div class="ks-track"><span class="k-progress" data-kit="scroll-progress"></span></div>
        <p class="t-label">This block</p>
        <div class="ks-track"><span class="k-progress" data-kit="scroll-progress" data-target="#ks-passage"></span></div>
      </div>
    </div>
  </article>

  <article class="kitdemo__item" id="demo-parallax">
    <header>
      <h3>parallax</h3>
      <p>Three layers drifting at different fractions of their distance from the viewport centre. Still under reduced motion.</p>
    </header>
    <div class="kitdemo__stage">
      <div class="ks-parallax">
        <img data-kit="parallax" data-speed="-0.12" src="{{ ph3 }}" alt="Placeholder: concentric arcs">
        <span class="ks-num t-num" data-kit="parallax" data-speed="-0.3">26</span>
        <p class="ks-cap t-label" data-kit="parallax" data-speed="0.12">h-index, Google Scholar</p>
      </div>
    </div>
  </article>

  <article class="kitdemo__item" id="demo-word-scrub">
    <header>
      <h3>word-scrub</h3>
      <p>The words light up as the paragraph crosses the viewport, and dim again scrolling back. The link and the emphasis survive.</p>
    </header>
    <div class="kitdemo__stage ks-scrub">
      <p data-kit="word-scrub">We build <em>fast</em> and side-channel aware implementations of post-quantum and homomorphic cryptography, on GPUs, FPGAs and the smallest microcontrollers, and we <a class="link" href="#demo-word-scrub">publish the code</a> so that others can measure it.</p>
    </div>
  </article>

  <article class="kitdemo__item" id="demo-marquee">
    <header>
      <h3>marquee</h3>
      <p>Constant motion that speeds up while the page scrolls and settles back. The second strip stops under the pointer and when a link in it has focus. The slanted banners run inside rotated boxes at 120 and 90 px/s, with <code>data-boost="0"</code> (the scroll does not speed them up).</p>
    </header>
    <div class="kitdemo__stage">
      <div class="ks-strip" data-kit="marquee" data-speed="34">
        <span>Fully homomorphic encryption</span><i>/</i><span>Post-quantum cryptography</span><i>/</i><span>GPU acceleration</span><i>/</i><span>Lattice-based schemes</span><i>/</i><span>Side-channel resistance</span><i>/</i>
      </div>
      <div class="ks-row" style="margin-top:1.5rem" data-kit="marquee" data-direction="right" data-speed="28" data-pause-on-hover>
        <a class="tag" href="#demo-marquee">IEEE TIFS</a><a class="tag" href="#demo-marquee">TCHES</a><a class="tag" href="#demo-marquee">IEEE TC</a><a class="tag" href="#demo-marquee">ACM TECS</a><a class="tag" href="#demo-marquee">IEEE TPDS</a><a class="tag" href="#demo-marquee">ACNS</a><a class="tag" href="#demo-marquee">CHES</a>
      </div>
      <div class="ks-banners" aria-hidden="true">
        <div class="ks-banner ks-banner--a" data-kit="marquee" data-speed="120" data-boost="0"><span>IEEE TDSC</span><span>IEEE TIFS</span><span>IEEE TC</span><span>TCHES</span><span>ACM TECS</span><span>IEEE TPDS</span><span>IEEE IoT-J</span></div>
        <div class="ks-banner ks-banner--b" data-kit="marquee" data-speed="90" data-direction="right" data-boost="0"><span>CHES</span><span>ACNS</span><span>DAC</span><span>ICCAD</span><span>ASIACCS</span><span>SAC</span><span>ISCAS</span></div>
      </div>
    </div>
  </article>

  <article class="kitdemo__item" id="demo-pin-x">
    <header>
      <h3>pin-x</h3>
      <p>Scrolling down moves the track sideways while the block stays put. Tab into a card to bring it into view. Touch, narrow screens and reduced motion get a swipeable row.</p>
    </header>
    <div class="kitdemo__stage">
      <section data-kit="pin-x" id="ks-pin" aria-label="Research themes">
        <div class="ks-pin-head">
          <h4 class="t-d3">Research themes</h4>
          <div class="ks-row">
            <button type="button" class="btn btn--ghost btn--small" onclick="var p=Site.get(document.getElementById('ks-pin'),'pin-x');p.go(p.index-1)">Previous</button>
            <button type="button" class="btn btn--ghost btn--small" onclick="var p=Site.get(document.getElementById('ks-pin'),'pin-x');p.go(p.index+1)">Next</button>
            <span class="ks-pin-bar"><span class="k-progress"></span></span>
          </div>
