  </g>
  {%- comment -%} the window, its projection, and the output cell being written {%- endcomment %}
  <g data-dg="win" data-x="60" data-y="58">
    <rect class="dg-w dg-f" style="--t: 0.6" x="60" y="58" width="48" height="48"/>
