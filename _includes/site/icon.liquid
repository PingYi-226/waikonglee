{%- comment -%}
  One inline icon.  {% include site/icon.liquid name="arrow-right" %}
  Parameters: name (required), size ("20" = 20px, or any CSS length; default 1.25em through .icon in icons.css),
  class (extra classes), label (an icon that carries its own meaning: role="img" + aria-label instead of aria-hidden).
  Drawn on a 24 px grid, 1.5 px strokes, round caps and joins, stroke="currentColor". The pieces carry k-i-* classes
  that icons.css animates when the icon's closest a / button / [data-icon-trigger] is hovered or focused.
  The list of names is in _work/agent_notes/kit-text.md; icons.js reads the same drawings (Site.icons.html).
{%- endcomment -%}
{%- assign icon_n = include.name | default: "arrow-right" -%}
{%- assign icon_sz = include.size | append: "" -%}
{%- assign icon_px = icon_sz | plus: 0 -%}
{%- assign icon_unit = icon_px | append: "" -%}
{%- assign icon_wh = 24 -%}
{%- comment -%} Liquid answers include.size with the number of parameters when no size is given (1 to 4): numbers below 5 mean "no size". {%- endcomment -%}
{%- if icon_sz != "" and icon_unit == icon_sz -%}
  {%- if icon_px < 5 -%}{%- assign icon_css = "" -%}{%- else -%}{%- assign icon_css = icon_sz | append: "px" -%}{%- assign icon_wh = icon_px -%}{%- endif -%}
{%- else -%}{%- assign icon_css = icon_sz -%}{%- endif -%}
<svg class="icon icon--{{ icon_n }}{% if include.class %} {{ include.class }}{% endif %}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="{{ icon_wh }}" height="{{ icon_wh }}"{% if icon_css != "" %} style="--icon-size:{{ icon_css }}"{% endif %} fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"{% if include.label %} role="img" aria-label="{{ include.label | escape }}"{% else %} aria-hidden="true"{% endif %} focusable="false">
{%- case icon_n -%}
{%- when "arrow-right" -%}<g class="k-i-a"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></g>
{%- when "arrow-up-right", "external" -%}<g class="k-i-a"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></g>
{%- when "arrow-down" -%}<g class="k-i-a"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></g>
{%- when "arrow-up" -%}<g class="k-i-a"><path d="m5 12 7-7 7 7"/><path d="M12 19V5"/></g>
{%- when "chevron-down" -%}<path class="k-i-a" d="m6 9 6 6 6-6"/>
{%- when "chevron-right" -%}<path class="k-i-a" d="m9 18 6-6-6-6"/>
{%- when "copy" -%}<rect class="k-i-front" x="8" y="8" width="14" height="14" rx="2"/><path class="k-i-back" d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
{%- when "check" -%}<path class="k-i-a" d="m4 12 5 5L20 6" pathLength="1"/>
{%- when "search" -%}<g class="k-i-a"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></g>
{%- when "menu" -%}<path class="k-i-l1" d="M4 6h16"/><path class="k-i-l2" d="M4 12h16"/><path class="k-i-l3" d="M4 18h16"/>
{%- when "close" -%}<path class="k-i-l1" d="M18 6 6 18"/><path class="k-i-l2" d="m6 6 12 12"/>
{%- when "sun" -%}<circle class="k-i-core" cx="12" cy="12" r="4"/><g class="k-i-rays"><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></g>
{%- when "moon" -%}<path class="k-i-a" d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
{%- when "mail" -%}<g class="k-i-a"><path class="k-i-body" d="M20 4c1.105 0 2 .895 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2l8 0a0 0 0 0 1 0 0l8 0Z"/><path class="k-i-flap" d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7"/></g>
{%- when "github" -%}<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path class="k-i-tail" d="M9 18c-4.51 2-5-2-7-2"/>
{%- when "scholar" -%}<path class="k-i-board" d="M21.42 10.92a1 1 0 0 0-.02-1.84L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.83l8.57 3.91a2 2 0 0 0 1.66 0z"/><path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5"/><path class="k-i-tassel" d="M22 10v6"/>
{%- when "orcid" -%}<circle cx="12" cy="12" r="10"/><path d="M8.5 10.5v6"/><path class="k-i-dot" d="M8.5 7.6v.01"/><path class="k-i-d" d="M12 10.5v6h1.5a3 3 0 0 0 0-6Z"/>
{%- when "scopus" -%}<rect x="3" y="3" width="18" height="18" rx="5"/><path class="k-i-s" d="M15 8.9C14.4 7.9 13.3 7.25 12 7.25c-1.8 0-3 .95-3 2.35 0 3.15 6.25 1.65 6.25 4.85 0 1.45-1.3 2.3-3.25 2.3-1.45 0-2.6-.55-3.25-1.6" pathLength="1"/>
{%- when "download" -%}<g class="k-i-a"><path d="M12 15V3"/><path d="m7 10 5 5 5-5"/></g><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
{%- when "file-text" -%}<path d="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.7.7l3.6 3.6A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z"/><path d="M14 2v5a1 1 0 0 0 1 1h5"/><path class="k-i-l1" d="M8 9h2" pathLength="1"/><path class="k-i-l2" d="M8 13h8" pathLength="1"/><path class="k-i-l3" d="M8 17h8" pathLength="1"/>
{%- when "code" -%}<path class="k-i-r" d="m16 18 6-6-6-6"/><path class="k-i-l" d="m8 6-6 6 6 6"/>
{%- when "quote" -%}<path class="k-i-q1" d="M10 11H6a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h3a1 1 0 0 1 1 1v6c0 2.67-1.33 4.33-4 5"/><path class="k-i-q2" d="M19 11h-4a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h3a1 1 0 0 1 1 1v6c0 2.67-1.33 4.33-4 5"/>
{%- when "link" -%}<path class="k-i-l1" d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path class="k-i-l2" d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
{%- when "map-pin" -%}<g class="k-i-a"><path d="M20 10c0 4.99-5.54 10.19-7.4 11.8a1 1 0 0 1-1.2 0C9.54 20.19 4 14.99 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></g>
{%- when "clock" -%}<circle cx="12" cy="12" r="10"/><path class="k-i-min" d="M12 12V6"/><path class="k-i-hr" d="m12 12 4 2"/>
{%- when "plus" -%}<path class="k-i-l1" d="M5 12h14"/><path class="k-i-l2" d="M12 5v14"/>
{%- when "minus" -%}<path class="k-i-a" d="M5 12h14"/>
{%- when "play" -%}<path class="k-i-a" d="M6.5 4.5v15L19 12Z"/>
{%- when "pause" -%}<rect class="k-i-r" x="14" y="4" width="4" height="16" rx="1"/><rect class="k-i-l" x="6" y="4" width="4" height="16" rx="1"/>
{%- when "zoom" -%}<circle class="k-i-lens" cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/><g class="k-i-sign"><path d="M11 8v6"/><path d="M8 11h6"/></g>
{%- else -%}<rect x="4" y="4" width="16" height="16" rx="3" stroke-dasharray="2 3"/>
{%- endcase -%}
</svg>
