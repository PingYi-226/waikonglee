{%- comment -%}
  Research page, the head (the first part of the page): the title and lede from the page's front matter, and under the
  rule the four figures of the page (areas, papers, repositories, projects). Each figure is a link to its part. Once the
  page has left the head, research.js flies the figures into a rail at the side of the viewport, where they stay as the
  page's navigation (the number and the last word of the label); back at the head they fly home. One set of links.
  Counts come from the data files (_data/research.yml, _data/software.yml, _data/grants.yml) and the bibliography.
{%- endcomment -%}
{%- assign repo_count = 0 -%}
{%- for g in site.data.software -%}{%- assign repo_count = repo_count | plus: g.items.size -%}{%- endfor -%}
{%- capture paper_count -%}{% bibliography_count %}{%- endcapture -%}
{%- assign paper_count = paper_count | strip -%}
{%- capture head_meta -%}
<nav class="rfig" aria-label="Parts of this page" data-rfig>
  <ol class="rfig__list" data-kit="highlight" data-mode="both" data-items=".rfig__link" data-rfig-list>
    <li class="rfig__item">
      <a class="rfig__link" href="#areas" data-rfig-link>
        <span class="rfig__num stat__value" data-rfig-part="num"><span data-kit="sliding-number" data-value="{{ site.data.research.size }}" data-delay="700">{{ site.data.research.size }}</span></span>
        <span class="rfig__label stat__label"><span class="rfig__q" data-rfig-part="q">research </span><span class="rfig__noun" data-rfig-part="noun">areas</span></span>
      </a>
    </li>
    <li class="rfig__item">
      <a class="rfig__link" href="#papers" data-rfig-link>
        <span class="rfig__num stat__value" data-rfig-part="num"><span data-kit="sliding-number" data-value="{{ paper_count }}" data-delay="760">{{ paper_count }}</span></span>
        <span class="rfig__label stat__label"><span class="rfig__q" data-rfig-part="q">peer-reviewed </span><span class="rfig__noun" data-rfig-part="noun">papers</span></span>
      </a>
    </li>
    <li class="rfig__item">
      <a class="rfig__link" href="#software" data-rfig-link>
        <span class="rfig__num stat__value" data-rfig-part="num"><span data-kit="sliding-number" data-value="{{ repo_count }}" data-delay="820">{{ repo_count }}</span></span>
        <span class="rfig__label stat__label"><span class="rfig__q" data-rfig-part="q">open-source </span><span class="rfig__noun" data-rfig-part="noun">repositories</span></span>
      </a>
    </li>
    <li class="rfig__item">
      <a class="rfig__link" href="#projects" data-rfig-link>
        <span class="rfig__num stat__value" data-rfig-part="num"><span data-kit="sliding-number" data-value="{{ site.data.grants.size }}" data-delay="880">{{ site.data.grants.size }}</span></span>
        <span class="rfig__label stat__label"><span class="rfig__q" data-rfig-part="q">funded </span><span class="rfig__noun" data-rfig-part="noun">projects</span></span>
      </a>
    </li>
  </ol>
</nav>
{%- endcapture -%}
<section class="rhead rpart" data-snap data-rhead>
  {% include site/pagehead.liquid meta=head_meta %}
</section>
