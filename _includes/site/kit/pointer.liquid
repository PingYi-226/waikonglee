{%- comment -%}
  Demos of the pointer and surface components (group P). Test markup only: the styles in the <style> block
  below lay the demos out and are not part of the kit; the kit's own styles are in assets/css/site/kit-pointer.css.
{%- endcomment -%}
<section class="kitdemo" id="kit-pointer">
  <h2 class="t-d2">pointer</h2>

  <style>
    #kit-pointer .pd-stack > * + * { margin-top: 2rem; }
    #kit-pointer .pd-note { margin: 0 0 0.6rem; font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.04em; color: var(--muted); }
    #kit-pointer .pd-nav { display: inline-flex; gap: 0.25rem; }
    #kit-pointer .pd-nav a { padding: 0.5rem 0.9rem; font-size: 0.95rem; color: var(--ink-2); border-radius: var(--r-pill); transition: color var(--t-color); }
    #kit-pointer .pd-nav a:hover, #kit-pointer .pd-nav a:focus-visible { color: var(--ink); }
    #kit-pointer .pd-chips { display: flex; flex-wrap: wrap; gap: 0.5rem; max-width: 34rem; }
    #kit-pointer .pd-chips .chip[aria-pressed="true"] { color: var(--ink); border-color: var(--line-strong); }
    #kit-pointer .pd-rows { margin: 0; padding: 0; list-style: none; max-width: 44rem; --k-highlight-inset: 0 -0.9rem; }
    #kit-pointer .pd-rows li + li { border-top: 1px solid var(--line); }
    #kit-pointer .pd-rows a { display: flex; align-items: baseline; justify-content: space-between; gap: 2rem; padding: 0.85rem 0; }
    #kit-pointer .pd-rows .t-label { flex: none; }
    #kit-pointer .pd-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.75rem; max-width: 44rem; --k-highlight-bg: var(--accent-soft); }
    #kit-pointer .pd-card { display: block; padding: 1rem 1.1rem 1.2rem; border: 1px solid var(--line); border-radius: var(--r-3); }
    #kit-pointer .pd-card p { margin: 0.3rem 0 0; font-size: var(--fs-xs); line-height: 1.5; color: var(--muted); }
    #kit-pointer .pd-side { display: inline-flex; flex-direction: column; min-width: 13rem; --k-highlight-selection-bg: var(--accent-soft); }
    #kit-pointer .pd-side a { padding: 0.5rem 0.8rem; font-size: 0.92rem; color: var(--muted); border-radius: var(--r-2); transition: color var(--t-color); }
    #kit-pointer .pd-side a[aria-current] { color: var(--accent); }
    @media (max-width: 560px) { #kit-pointer .pd-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    /* tabs */
    #kit-pointer .pd-panel { padding-top: 1.25rem; max-width: 40rem; }
    #kit-pointer .pd-panel ul { margin: 0.6rem 0 0; padding-left: 1.1rem; color: var(--ink-2); }
    #kit-pointer .pd-after { margin-top: 1.25rem; padding-top: 0.9rem; border-top: 1px solid var(--line); font-size: var(--fs-xs); color: var(--muted); }
    #kit-pointer .pd-vtabs { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 1.5rem; align-items: start; max-width: 44rem; }
    #kit-pointer .pd-vtabs .pd-panel { padding-top: 0.35rem; }
    @media (max-width: 560px) { #kit-pointer .pd-vtabs { grid-template-columns: 1fr; } }
    /* disclosure */
    #kit-pointer .pd-pubs { margin: 0; padding: 0; list-style: none; max-width: 44rem; }
    #kit-pointer .pd-pubs > li { border-top: 1px solid var(--line); }
    #kit-pointer .pd-pubs > li:last-child { border-bottom: 1px solid var(--line); }
    #kit-pointer .pd-pub { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; padding: 0.8rem 0; }
    #kit-pointer .pd-abs { padding: 0 0 1.1rem; font-size: var(--fs-small); line-height: 1.6; color: var(--ink-2); max-width: 38rem; }
    #kit-pointer .pd-abs .btn { margin-top: 0.8rem; }
    #kit-pointer .pd-chev { width: 0.9rem; height: 0.9rem; }
    #kit-pointer .pd-col { display: flex; flex-direction: column; gap: 1rem; max-width: 30rem; }
    #kit-pointer .pd-col .card { padding: 0.9rem 1.1rem; font-size: var(--fs-small); }
    /* flip */
    #kit-pointer .pd-tools { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; margin-bottom: 1rem; }
    #kit-pointer .pd-tools .pd-gap { flex: 1 1 1rem; }
    #kit-pointer .pd-list { margin: 0; padding: 0; list-style: none; max-width: 44rem; display: flex; flex-direction: column; }
    #kit-pointer .pd-list > li { display: flex; align-items: baseline; justify-content: space-between; gap: 2rem; padding: 0.7rem 0; border-top: 1px solid var(--line); background: var(--paper); }
    #kit-pointer .pd-list > li[hidden] { display: none; }
    #kit-pointer .pd-list--long > li { padding: 0.45rem 0; font-size: var(--fs-small); }
    #kit-pointer .pd-cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.75rem; max-width: 44rem; }
    #kit-pointer .pd-cards > .card { padding: 0.9rem 1rem 1rem; }
    #kit-pointer .pd-cards > .card[hidden] { display: none; }
    #kit-pointer .pd-cards .t-label { display: block; margin-bottom: 0.25rem; }
    @media (max-width: 560px) { #kit-pointer .pd-cards { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    /* tooltip, copy, lightbox */
    #kit-pointer .pd-ico { width: 1.25rem; height: 1.25rem; }
    #kit-pointer .pd-bib { display: flex; align-items: flex-start; gap: 0.5rem; max-width: 40rem; padding: 0.75rem 0.75rem 0.75rem 1rem; border: 1px solid var(--line); border-radius: var(--r-3); }
    #kit-pointer .pd-bib pre { flex: 1; min-width: 0; margin: 0; padding: 0.25rem 0; overflow-x: auto; font-family: var(--font-mono); font-size: 0.76rem; line-height: 1.6; color: var(--ink-2); background: none; border: 0; }
    #kit-pointer .pd-shots { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 1.25rem; }
    #kit-pointer .pd-portrait { width: 9rem; height: auto; border-radius: var(--r-2); }
    #kit-pointer .pd-avatar { width: 5.5rem; height: 5.5rem; padding: 0; overflow: hidden; background: none; border: 0; border-radius: 50%; }
    #kit-pointer .pd-avatar img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 20%; }
    #kit-pointer .pd-thumb { display: block; width: 11rem; aspect-ratio: 4 / 3; overflow: hidden; border-radius: var(--r-2); }
    #kit-pointer .pd-thumb img { width: 100%; height: 100%; object-fit: cover; }
    /* buttons */
    #kit-pointer .pd-combos { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2.5rem 1.5rem; max-width: 52rem; }
    #kit-pointer .pd-combo { display: flex; flex-direction: column; align-items: flex-start; gap: 0.7rem; }
    #kit-pointer .pd-combo .pd-note { margin: 0; }
    #kit-pointer .pd-btncard { display: block; width: 15rem; padding: 1rem 1.1rem 1.15rem; }
    #kit-pointer .pd-btncard__t { display: block; margin-top: 0.35rem; font-family: var(--font-display); font-size: 1.35rem; line-height: 1.15; }
    @media (max-width: 560px) { #kit-pointer .pd-combos { grid-template-columns: 1fr 1fr; } }
    /* spotlight, hover-fill */
    #kit-pointer .pd-rgrid { display: grid; grid-template-columns: repeat(3, 300px); gap: 14px; }
    #kit-pointer .pd-rcard { position: relative; display: flex; flex-direction: column; justify-content: space-between; height: 188px; padding: 1rem 1.1rem; color: var(--ink); background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-3); --k-fill-bg: var(--paper-2); }
    html[data-theme="dark"] #kit-pointer .pd-rcard { --k-fill-bg: var(--paper-3); }
    #kit-pointer .pd-rcard__fig { width: 100%; height: 78px; color: var(--ink-2); }
    #kit-pointer .pd-rcard__name { font-family: var(--font-display); font-size: 1.3rem; line-height: 1.1; }
    #kit-pointer .pd-rcard__name { max-width: 58%; }
    #kit-pointer .pd-rcard__more { position: absolute; right: 1.1rem; bottom: 1rem; display: inline-flex; align-items: center; gap: 0.35rem; font-size: var(--fs-xs); color: var(--muted); }
    #kit-pointer .pd-people { display: grid; grid-template-columns: repeat(3, 15rem); gap: 10px; }
    #kit-pointer .pd-person { display: grid; grid-template-columns: auto 1fr; column-gap: 0.8rem; align-items: center; padding: 0.8rem 0.9rem; border: 1px solid var(--line); border-radius: var(--r-2); }
    #kit-pointer .pd-person__mark { grid-row: span 2; display: grid; place-items: center; width: 2.4rem; height: 2.4rem; font-family: var(--font-display); font-size: 1.3rem; border: 1px solid var(--line-strong); border-radius: 50%; }
    #kit-pointer .pd-person__name { font-size: var(--fs-small); }
    #kit-pointer .pd-person__deg { font-size: var(--fs-xs); color: var(--muted); }
    @media (max-width: 1000px) { #kit-pointer .pd-rgrid { grid-template-columns: repeat(2, minmax(0, 300px)); } #kit-pointer .pd-people { grid-template-columns: repeat(2, minmax(0, 15rem)); } }
    @media (max-width: 560px) { #kit-pointer .pd-rgrid, #kit-pointer .pd-people { grid-template-columns: minmax(0, 1fr); } }
    /* unfold */
    #kit-pointer #pd-unfold { max-width: 50rem; }
    #kit-pointer .pd-uabs { padding: 0.2rem 0 1.3rem 1.25rem; max-width: 44rem; }
    #kit-pointer .pd-uabs p { margin: 0; font-size: var(--fs-small); line-height: 1.65; color: var(--ink-2); }
    #kit-pointer .pd-ubib { padding: 0.2rem 0 1.3rem 1.25rem; }
  </style>

  <article class="kitdemo__item" id="demo-highlight">
    <header>
      <h3>highlight</h3>
      <p>Move the pointer across each group, then use Tab. Click a chip or a section link to move the selection.</p>
    </header>
    <div class="kitdemo__stage pd-stack">
      <div>
        <p class="pd-note">hover, a row</p>
        <nav class="pd-nav" id="pd-nav" data-kit="highlight" aria-label="Demo: sections">
          <a href="#demo-highlight" data-highlight-item>Research</a>
          <a href="#demo-highlight" data-highlight-item>Publications</a>
          <a href="#demo-highlight" data-highlight-item>Group</a>
          <a href="#demo-highlight" data-highlight-item>Teaching</a>
          <a href="#demo-highlight" data-highlight-item>Contact</a>
        </nav>
      </div>
      <div>
        <p class="pd-note">both, a wrapped row of chips (with press)</p>
        <div class="pd-chips" id="pd-chips" data-kit="highlight" data-mode="both" role="group" aria-label="Demo: filter by topic">
          <button type="button" class="chip" data-kit="press" data-highlight-item aria-pressed="true">All <span class="t-num">90</span></button>
          <button type="button" class="chip" data-kit="press" data-highlight-item aria-pressed="false">Post-quantum cryptography</button>
          <button type="button" class="chip" data-kit="press" data-highlight-item aria-pressed="false">GPU</button>
          <button type="button" class="chip" data-kit="press" data-highlight-item aria-pressed="false">FPGA</button>
          <button type="button" class="chip" data-kit="press" data-highlight-item aria-pressed="false">Homomorphic encryption</button>
          <button type="button" class="chip" data-kit="press" data-highlight-item aria-pressed="false">IoT</button>
          <button type="button" class="chip" data-kit="press" data-highlight-item aria-pressed="false">Neural networks</button>
          <button type="button" class="chip" data-kit="press" data-highlight-item aria-pressed="false" disabled>Archived</button>
        </div>
      </div>
      <div>
        <p class="pd-note">hover, a column of rows (the surface is wider than the row: --k-highlight-inset)</p>
        <ul class="pd-rows" id="pd-rows" data-kit="highlight" data-items="a">
          <li><a href="#demo-highlight"><span>High Throughput Lattice-Based Signatures on GPUs: Comparing Falcon and Mitaka</span><span class="t-label">2024</span></a></li>
          <li><a href="#demo-highlight"><span>Speed Record of AES-CTR and AES-ECB Bit-Sliced Implementation on GPUs</span><span class="t-label">2024</span></a></li>
          <li><a href="#demo-highlight"><span>cuFE: High Performance Privacy Preserving Support Vector Machine With Inner-Product Functional Encryption</span><span class="t-label">2024</span></a></li>
          <li><a href="#demo-highlight"><span>QuripfeNet: Quantum-Resistant IPFE-Based Neural Network</span><span class="t-label">2025</span></a></li>
        </ul>
      </div>
      <div>
        <p class="pd-note">hover, a grid</p>
        <div class="pd-grid" id="pd-grid" data-kit="highlight" data-items=".pd-card">
          <a class="pd-card" href="#demo-highlight"><span class="t-d4">Lattice signatures</span><p>Falcon, Mitaka and Dilithium at high throughput.</p></a>
          <a class="pd-card" href="#demo-highlight"><span class="t-d4">Key encapsulation</span><p>Kyber, Saber and Scabbard on tensor cores.</p></a>
          <a class="pd-card" href="#demo-highlight"><span class="t-d4">Functional encryption</span><p>Inner products for private inference.</p></a>
          <a class="pd-card" href="#demo-highlight"><span class="t-d4">Symmetric ciphers</span><p>Bit-sliced AES and lightweight AEAD.</p></a>
          <a class="pd-card" href="#demo-highlight"><span class="t-d4">Accelerators</span><p>Co-processors shared by CNNs and polynomials.</p></a>
          <a class="pd-card" href="#demo-highlight"><span class="t-d4">Embedded</span><p>ARMv8 and RISC-V for the IoT edge.</p></a>
        </div>
      </div>
      <div>
        <p class="pd-note">both, a column (aria-current)</p>
        <nav class="pd-side" id="pd-side" data-kit="highlight" data-mode="both" data-items="a" aria-label="Demo: on this page">
          <a href="#demo-highlight" aria-current="true">Overview</a>
          <a href="#demo-highlight">Selected results</a>
          <a href="#demo-highlight">Funding</a>
          <a href="#demo-highlight">Open positions</a>
        </nav>
      </div>
    </div>
  </article>

  <article class="kitdemo__item" id="demo-buttons">
    <header>
      <h3>buttons: grow, press, release, pull, ripple</h3>
      <p>Hover: the control grows (CSS <code>scale</code>, 300 ms ease-out) and its icon moves a beat later. Press: it shrinks back (<code>press</code>, on <code>transform</code>). Let go: it springs once past its size. The magnetic pull (<code>translate</code>) and the ripple add to it. Tab to a control: it grows too. The card tilts (<code>tilt</code>, also on <code>transform</code>) and presses at the same time.</p>
    </header>
    <div class="kitdemo__stage pd-stack">
      <div class="pd-combos">
        <div class="pd-combo">
          <a class="btn" href="#demo-buttons" data-kit="magnetic press ripple" id="pd-b-primary"><span data-kit="sliding-text">Publications</span>{% include site/icon.liquid name="arrow-right" %}</a>
          <span class="pd-note">primary: magnetic press ripple</span>
        </div>
        <div class="pd-combo">
          <a class="btn btn--ghost" href="#demo-buttons" data-kit="magnetic press ripple" id="pd-b-ghost"><span data-kit="sliding-text">Research</span>{% include site/icon.liquid name="arrow-right" %}</a>
          <span class="pd-note">ghost: magnetic press ripple</span>
        </div>
        <div class="pd-combo">
          <button type="button" class="btn btn--ghost btn--small" data-kit="press" id="pd-b-small">{% include site/icon.liquid name="download" %}<span data-kit="sliding-text">Download CV</span></button>
          <span class="pd-note">small ghost: press</span>
        </div>
        <div class="pd-combo">
          <button type="button" class="chip" data-kit="press" id="pd-b-chip">GPU</button>
          <span class="pd-note">chip: press</span>
        </div>
        <div class="pd-combo">
          <a class="icon-btn" href="#demo-buttons" data-kit="magnetic press tooltip" data-tip="GitHub" aria-label="GitHub" id="pd-b-icon">{% include site/icon.liquid name="github" %}</a>
          <span class="pd-note">icon button: magnetic press tooltip</span>
        </div>
        <div class="pd-combo">
          <a class="card pd-btncard" href="#demo-buttons" data-kit="tilt press" data-press="choice" data-shine id="pd-b-card">
            <span class="t-label">Post-quantum</span>
            <span class="pd-btncard__t">Lattice signatures on GPUs</span>
          </a>
          <span class="pd-note">card: tilt press</span>
        </div>
      </div>
    </div>
  </article>

  <article class="kitdemo__item" id="demo-spotlight">
    <header>
      <h3>spotlight, hover-fill</h3>
      <p>Move across the grid: the card under the pointer takes a soft light and the borders of its neighbours light up near the pointer (<code>spotlight</code> on the grid). Each card fills from the side the pointer came in and empties toward where it left; the count and the icon come in a beat later (<code>hover-fill</code>, <code>data-hover-show</code>). Leave and come back quickly: the fill turns round. Tab through the cards: the same, from the centre. The second grid is the people layout. Try the dark theme.</p>
    </header>
    <div class="kitdemo__stage pd-stack">
      <div class="pd-rgrid" data-kit="spotlight" id="pd-spot">
        {%- assign pd_areas = "Post-quantum cryptography|Homomorphic encryption|Accelerators for deep learning|Privacy-preserving machine learning|High-performance computing|Security of embedded systems" | split: "|" -%}
        {%- assign pd_counts = "34|21|18|12|27|15" | split: "|" -%}
        {%- for name in pd_areas -%}
        <a class="pd-rcard" href="#demo-spotlight" data-kit="hover-fill press tilt" data-press="choice" data-max="4" id="pd-rcard-{{ forloop.index }}">
          <svg class="pd-rcard__fig" viewBox="0 0 120 60" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round">{% for k in (0..5) %}<line x1="{{ k | times: 20 | plus: 10 }}" y1="8" x2="{{ k | times: 20 | plus: 10 }}" y2="52" stroke-opacity="0.25"/>{% endfor %}<path d="M8 44 C 30 {{ forloop.index | times: 6 | plus: 4 }}, 70 52, 112 {{ forloop.index | times: 5 | plus: 8 }}" stroke="var(--accent)"/></g></svg>
          <span class="pd-rcard__name">{{ name }}</span>
          <span class="pd-rcard__more" data-hover-show><span class="t-data">{{ pd_counts[forloop.index0] }}</span> papers {% include site/icon.liquid name="arrow-right" %}</span>
        </a>
        {%- endfor -%}
      </div>
      <div class="pd-people" data-kit="spotlight" data-radius="180" id="pd-spot-people">
        {%- assign pd_people = "Ang Jia Wei|Lim Mei Ling|Tan Kok Seng|Nur Aisyah|Wong Jun Hao|Chen Yi" | split: "|" -%}
        {%- for p in pd_people -%}
        <div class="pd-person" data-kit="hover-fill" tabindex="0">
          <span class="pd-person__mark" aria-hidden="true">{{ p | slice: 0 }}</span>
          <span class="pd-person__name">{{ p }}</span>
          <span class="pd-person__deg" data-hover-show>{% if forloop.index0 == 1 or forloop.index0 == 4 %}Master{% else %}PhD{% endif %}, since 202{{ forloop.index | plus: 1 }}</span>
        </div>
        {%- endfor -%}
      </div>
    </div>
  </article>

  <article class="kitdemo__item" id="demo-press">
    <header>
      <h3>press</h3>
      <p>Press and hold a button, or the whole row; hold Space on a focused button.</p>
    </header>
    <div class="kitdemo__stage pd-stack">
      <div class="cluster">
        <button type="button" class="btn" data-kit="press" id="pd-press">Read the paper</button>
        <button type="button" class="btn btn--ghost" data-kit="press">Download CV</button>
        <a class="btn btn--ghost btn--small" href="#demo-press" data-kit="press">Scholar profile</a>
      </div>
      <a class="card" href="#demo-press" data-kit="press" data-press="choice" id="pd-choice" style="display:block;max-width:26rem;padding:1.1rem 1.25rem">
        <span class="t-label">Selected result</span>
        <span class="t-d4" style="display:block;margin-top:0.3rem">20.03× faster Falcon verification on an A100 GPU</span>
      </a>
    </div>
  </article>

  <article class="kitdemo__item" id="demo-tabs">
    <header>
      <h3>tabs</h3>
      <p>Click a tab or use the arrow keys, Home and End. The panels have different heights: the line under them glides. The second set advances by itself and pauses under the pointer.</p>
    </header>
    <div class="kitdemo__stage pd-stack">
      <div data-kit="tabs" data-highlight="both" id="pd-tabs">
        <div class="k-seg" role="tablist" aria-label="Demo: research areas">
          <button class="k-seg__item" role="tab" data-kit="press" aria-selected="true">Post-quantum</button>
          <button class="k-seg__item" role="tab" data-kit="press">Homomorphic encryption</button>
          <button class="k-seg__item" role="tab" data-kit="press">Accelerators</button>
          <button class="k-seg__item" role="tab" data-kit="press" disabled>Archive</button>
        </div>
        <div>
          <div class="pd-panel" role="tabpanel">
            <p>Lattice-based signatures and key encapsulation at high throughput: Falcon, Mitaka, Dilithium, Kyber and Saber on GPUs.</p>
          </div>
          <div class="pd-panel" role="tabpanel">
            <p>Computing on encrypted data without decrypting it. The group works on the number-theoretic transforms and the bootstrapping that make it practical.</p>
            <ul>
              <li>Batched NTT kernels shared by CKKS and BFV</li>
              <li>Key switching on tensor cores</li>
              <li>Functional encryption for private inference</li>
            </ul>
          </div>
          <div class="pd-panel" role="tabpanel">
            <p>Co-processors on FPGA that share their multipliers between neural networks and polynomial arithmetic. <a class="link" href="#demo-tabs">See Cryptensor</a>.</p>
          </div>
          <div class="pd-panel" role="tabpanel"><p>Older work.</p></div>
        </div>
        <p class="pd-after">This line sits under the panels: it must glide, never jump.</p>
      </div>

      <div class="pd-vtabs" data-kit="tabs" data-autoplay="3200" id="pd-tabs-auto">
        <div class="k-seg" role="tablist" aria-orientation="vertical" aria-label="Demo: platforms">
          <button class="k-seg__item" role="tab" aria-selected="true">GPUs</button>
          <button class="k-seg__item" role="tab">FPGAs</button>
          <button class="k-seg__item" role="tab">Embedded</button>
        </div>
        <div>
          <div class="pd-panel" role="tabpanel"><p class="t-d4">20.03× faster Falcon verification</p><p class="t-muted t-small">On an A100, against the reference implementation.</p></div>
          <div class="pd-panel" role="tabpanel"><p class="t-d4">One multiplier, two workloads</p><p class="t-muted t-small">A resource-shared co-processor for CNNs and polynomial convolution.</p></div>
          <div class="pd-panel" role="tabpanel"><p class="t-d4">Rainbow on ARMv8</p><p class="t-muted t-small">Table-based signatures for 64-bit processors.</p></div>
        </div>
      </div>
    </div>
  </article>

  <article class="kitdemo__item" id="demo-disclosure">
    <header>
      <h3>disclosure</h3>
      <p>Open an abstract: only one stays open (a group). Click twice quickly: it turns round. Close it from the button inside: focus returns to the trigger. The card below starts open.</p>
    </header>
    <div class="kitdemo__stage pd-stack">
      <ul class="pd-pubs">
        <li>
          <div class="pd-pub">
            <span>High Throughput Lattice-Based Signatures on GPUs: Comparing Falcon and Mitaka</span>
            <button class="chip" data-kit="disclosure press" data-group="pd-abstracts" aria-controls="pd-abs-1" aria-expanded="false" id="pd-dis-1">Abstract <svg class="pd-chev" data-disclosure-icon viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></button>
          </div>
          <div id="pd-abs-1" data-disclosure-panel>
            <div class="pd-abs">The US National Institute of Standards and Technology initiated a standardization process for post-quantum cryptography. Falcon was selected for its compact signatures; Mitaka is a simpler variant that is easier to parallelize. This work implements both on GPUs and compares their throughput for signing and verification.
              <br><button type="button" class="btn btn--ghost btn--small" data-pd-close="pd-dis-1">Close</button>
            </div>
          </div>
        </li>
        <li>
          <div class="pd-pub">
            <span>Speed Record of AES-CTR and AES-ECB Bit-Sliced Implementation on GPUs</span>
            <button class="chip" data-kit="disclosure press" data-group="pd-abstracts" aria-controls="pd-abs-2" aria-expanded="false" id="pd-dis-2">Abstract <svg class="pd-chev" data-disclosure-icon viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></button>
          </div>
          <div id="pd-abs-2" data-disclosure-panel>
            <div class="pd-abs">Bit-slicing packs many AES states into machine words so that one logical operation processes all of them. On GPUs the technique reaches a new speed record for the counter and electronic-codebook modes while staying constant-time.</div>
          </div>
        </li>
        <li>
          <div class="pd-pub">
            <span>QuripfeNet: Quantum-Resistant IPFE-Based Neural Network</span>
            <button class="chip" data-kit="disclosure press" data-group="pd-abstracts" aria-controls="pd-abs-3" aria-expanded="false" id="pd-dis-3">Abstract <svg class="pd-chev" data-disclosure-icon viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></button>
          </div>
          <div id="pd-abs-3" data-disclosure-panel>
            <div class="pd-abs">Inner-product functional encryption lets a server evaluate the first layer of a network on encrypted inputs. QuripfeNet builds it from lattice assumptions, so that it stays secure against quantum adversaries, and accelerates it on GPUs.</div>
          </div>
        </li>
      </ul>

      <div class="pd-col">
        <button class="btn btn--ghost btn--small" style="align-self:flex-start" data-kit="disclosure press" aria-controls="pd-note-1" aria-expanded="true" id="pd-dis-open">Funding note <svg class="pd-chev" data-disclosure-icon viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></button>
        <div id="pd-note-1" data-disclosure-panel data-open>
          <div class="card">Open at load, inside a column with a gap: the gap closes with the panel.</div>
        </div>
        <p class="t-xs t-muted" style="margin:0">The paragraph after the panel.</p>
      </div>
    </div>
  </article>

