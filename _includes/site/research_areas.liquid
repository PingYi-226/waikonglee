{%- comment -%}
  Research page, the areas (_data/research.yml): the page's one set piece.
  Wide screens with JavaScript: a sticky figure plate on the left (one diagram per area, stacked; research.js shows the
  one of the area being read, the old one clearing through blur, the new one drawing itself), its caption (the figure
  number rolls, the tagline changes) and an index of the areas with a gliding mark (scrollspy + highlight); the seven
  areas as tall text blocks on the right, the one being read in full ink.
  Small screens, and without JavaScript: each area carries its own figure above its text; nothing sticks.
  Each area keeps its anchor (#pqc, #accel ...): the home page links to them.
{%- endcomment -%}
{%- assign areas = site.data.research -%}
<section class="rareas section" id="areas" aria-labelledby="rareas-title" data-rareas>
  <div class="wrap">
    <header class="sechead" data-inview>
      <h2 class="sechead__title" id="rareas-title">Research areas</h2>
    </header>

    <div class="rareas__grid">
      <div class="rplate" data-rplate>
        <div class="rplate__sticky">
          {%- comment -%} The plate repeats what each area's own figure says, so it is hidden from screen readers. {%- endcomment -%}
          <div class="rplate__frame" data-rplate-frame data-cursor="Redraw" aria-hidden="true">
            {%- for a in areas %}
            <span class="rplate__fig{% if forloop.first %} is-current{% endif %}" data-rplate-fig>
              {% include site/diagrams/{{ a.key }}.liquid live="always" trigger="manual" detail="full" %}
            </span>
            {%- endfor %}
          </div>
          <button
            type="button"
            class="rplate__pause icon-btn"
            data-kit="press tooltip"
            data-tip="Pause the figure"
            aria-label="Pause the figure"
            data-rplate-pause
          >
            {% include site/icon.liquid name="pause" size=16 %}
          </button>
          <p class="rplate__cap figcap" aria-hidden="true">
            <span class="figcap__no">Fig. <span data-kit="sliding-number" data-trigger="manual" data-value="1" data-from="1" data-rplate-no>1</span></span>
            <span class="rplate__tags">
              {%- for a in areas -%}
                <span class="rplate__tag{% if forloop.first %} is-current{% endif %}" data-rplate-tag>{{ a.tagline }}</span>
              {%- endfor -%}
            </span>
          </p>
          <nav class="rindex" aria-label="Research areas">
            <ol class="rindex__list" data-kit="scrollspy highlight" data-mode="both" data-items=".rindex__link" data-rindex>
              {%- for a in areas %}
              <li>
                <a class="rindex__link" href="#{{ a.key }}">
                  <span class="rindex__name">{{ a.short | default: a.title }}</span>
                  <span class="rindex__count t-data">{% bibliography_count --query @*[theme={{ a.key }}] %}</span>
                </a>
              </li>
              {%- endfor %}
            </ol>
          </nav>
        </div>
      </div>

      <div class="rareas__list">
        {%- for a in areas %}
        {%- capture n -%}{% bibliography_count --query @*[theme={{ a.key }}] %}{%- endcapture -%}
        {%- assign n = n | strip %}
        <article class="rarea{% if forloop.first %} is-active{% endif %}" id="{{ a.key }}" aria-labelledby="rarea-{{ a.key }}" data-rarea>
          <figure class="rarea__fig">
            <span class="rarea__plate" data-rarea-fig>
              {% include site/diagrams/{{ a.key }}.liquid live="always" trigger="manual" detail="full" %}
            </span>
            <figcaption class="figcap"><span class="figcap__no">Fig. {{ forloop.index }}</span><span>{{ a.tagline }}</span></figcaption>
          </figure>
          <div class="rarea__text">
            <h3 class="rarea__title" id="rarea-{{ a.key }}">{{ a.title }}</h3>
            <p class="rarea__desc">{{ a.description }}</p>
            <p class="rarea__foot">
              <span class="rarea__count"><span class="t-data">{{ n }}</span> {% if n == '1' %}paper{% else %}papers{% endif %}</span>
              <a class="link" href="{{ '/publications/' | relative_url }}#area={{ a.key }}">Papers in this area</a>
            </p>
          </div>
        </article>
        {%- endfor %}
      </div>
    </div>
  </div>
</section>
