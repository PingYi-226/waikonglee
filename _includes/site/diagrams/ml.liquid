    <circle class="dg-s dg-p" style="--k: 6" cx="100" cy="98" r="2.33" fill="currentColor"/>
    <circle class="dg-s dg-p" style="--k: 7" cx="116" cy="98" r="2.64" fill="currentColor"/>
