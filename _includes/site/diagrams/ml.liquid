  </g>
  <g class="dg-h" style="--t: 0.74">
    <line class="dg-d" data-dg="ray" pathLength="1" x1="108" y1="58" x2="228" y2="74"/>
    <line class="dg-d" data-dg="ray" style="--k: 3" pathLength="1" x1="108" y1="106" x2="228" y2="90"/>
  </g>
  <g data-dg="cell" data-x="228" data-y="74">
    <rect class="dg-sa dg-p" style="--t: 0.92" x="232" y="78" width="8" height="8" fill="currentColor"/>
  </g>
  {%- if include.detail == 'full' %}
  <g class="dg-f" style="--t: 1">
    <text class="dg-sym" x="92" y="153" text-anchor="middle">x</text>
    <text class="dg-sym" x="244" y="137" text-anchor="middle">k ∗ x</text>
  </g>
