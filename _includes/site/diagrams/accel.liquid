    <path class="dg-d" style="--k: 5" pathLength="1" d="M47 90H167"/>
    <path class="dg-d" style="--k: 7" pathLength="1" d="M47 120H167"/>
  </g>
  {%- comment -%} the bytes, row by row: column 0 solid, the rest faint; three copies of each row for the wrap {%- endcomment %}
  <g style="--t: 0.3">
    <svg x="47" y="30" width="120" height="30" viewBox="47 30 120 30">
      <g data-dg="row" data-r="0">
        <circle class="dg-s dg-p" cx="62" cy="45" r="3" fill="currentColor"/>
