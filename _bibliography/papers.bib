  title             = {High speed implementation of symmetric block cipher on GPU},
  author            = {Lee, Wai-Kong and Goi, Bok-Min and Phan, Raphael C.-W. and Poh, Geong-Sen},
  booktitle         = {International Symposium on Intelligent Signal Processing and Communication Systems (ISPACS)},
