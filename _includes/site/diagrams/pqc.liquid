{%- comment -%}
  Post-quantum cryptography: the closest-vector picture behind lattice schemes.
  A lattice generated by b1 = (44, -8) and b2 = (16, -38) from the origin (92, 124), its fundamental cell, a target t off the
  lattice, the closest lattice point ringed (with its Voronoi cell as a faint wash) and the short error vector e = t - v.
  Live: the target drifts through three neighbouring cells; the ring hops to the new closest point (diagrams.js, SCENES.pqc).
  Parameters: live (hover | always | off), trigger (view | manual), detail ("full" shows the labels), class.
{%- endcomment -%}
<svg class="diagram diagram--pqc{% if include.class %} {{ include.class }}{% endif %}" viewBox="0 0 320 180" data-kit="diagram" data-live="{{ include.live | default: 'hover' }}" data-trigger="{{ include.trigger | default: 'view' }}"{% if include.detail == 'full' %} data-detail="full"{% endif %} role="img" aria-label="A lattice with its two basis vectors, a target point off the lattice, its closest lattice point ringed, and the short error vector between them." fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
  {%- comment -%} the decoding region of the ringed point: its Voronoi cell {%- endcomment %}
  <g data-dg="ring" data-x="196" data-y="70">
    <path class="dg-w dg-f" style="--t: 0.62" d="M172.2 64.1L191.8 45.9L216.2 56.1L219.8 75.9L200.2 94.1L175.8 83.9Z"/>
    <circle class="dg-a dg-d" style="--t: 0.78" pathLength="1" cx="196" cy="70" r="7"/>
  </g>
  {%- comment -%} the lattice: points pop outward from the origin; they fade towards the edges, where the lattice goes on {%- endcomment %}
  <g style="--t: 0">
    <circle class="dg-s dg-p" data-dg="pt" cx="92" cy="124" r="2.4" fill="currentColor"/>
    <circle class="dg-s dg-p" data-dg="pt" cx="64" cy="94" r="1.9" fill="currentColor" fill-opacity="0.87" style="--k: 3"/>
    <circle class="dg-s dg-p" data-dg="pt" cx="120" cy="154" r="1.9" fill="currentColor" fill-opacity="0.57" style="--k: 3"/>
    <circle class="dg-s dg-p" data-dg="pt" cx="108" cy="86" r="1.9" fill="currentColor" style="--k: 3"/>
    <circle class="dg-s dg-p" data-dg="pt" cx="48" cy="132" r="1.9" fill="currentColor" fill-opacity="0.47" style="--k: 3"/>
    <circle class="dg-s dg-p" data-dg="pt" cx="136" cy="116" r="1.9" fill="currentColor" style="--k: 3"/>
    <circle class="dg-s dg-p" data-dg="pt" cx="80" cy="56" r="1.9" fill="currentColor" fill-opacity="0.81" style="--k: 4"/>
    <circle class="dg-s dg-p" data-dg="pt" cx="164" cy="146" r="1.9" fill="currentColor" fill-opacity="0.78" style="--k: 5"/>
    <circle class="dg-s dg-p" data-dg="pt" cx="152" cy="78" r="1.9" fill="currentColor" style="--k: 5"/>
    <circle class="dg-s dg-p" data-dg="pt" cx="36" cy="64" r="1.9" fill="currentColor" fill-opacity="0.51" style="--k: 5"/>
    <circle class="dg-s dg-p" data-dg="pt" cx="124" cy="48" r="1.9" fill="currentColor" fill-opacity="0.96" style="--k: 5"/>
    <circle class="dg-s dg-p" data-dg="pt" cx="180" cy="108" r="1.9" fill="currentColor" style="--k: 6"/>
    <circle class="dg-s dg-p" data-dg="pt" cx="52" cy="26" r="1.9" fill="currentColor" fill-opacity="0.28" style="--k: 7"/>
    <circle class="dg-s dg-p" data-dg="pt" cx="168" cy="40" r="1.9" fill="currentColor" fill-opacity="0.89" style="--k: 7"/>
    <circle class="dg-s dg-p" data-dg="pt" cx="208" cy="138" r="1.9" fill="currentColor" fill-opacity="0.81" style="--k: 7"/>
    <circle class="dg-s dg-p" data-dg="pt" cx="196" cy="70" r="1.9" fill="currentColor" style="--k: 7"/>
    <circle class="dg-s dg-p" data-dg="pt" cx="224" cy="100" r="1.9" fill="currentColor" style="--k: 8"/>
    <circle class="dg-s dg-p" data-dg="pt" cx="212" cy="32" r="1.9" fill="currentColor" fill-opacity="0.63" style="--k: 9"/>
    <circle class="dg-s dg-p" data-dg="pt" cx="252" cy="130" r="1.9" fill="currentColor" fill-opacity="0.65" style="--k: 10"/>
    <circle class="dg-s dg-p" data-dg="pt" cx="240" cy="62" r="1.9" fill="currentColor" fill-opacity="0.87" style="--k: 10"/>
    <circle class="dg-s dg-p" data-dg="pt" cx="268" cy="92" r="1.9" fill="currentColor" fill-opacity="0.75" style="--k: 11"/>
    <circle class="dg-s dg-p" data-dg="pt" cx="256" cy="24" r="1.9" fill="currentColor" fill-opacity="0.28" style="--k: 12"/>
    <circle class="dg-s dg-p" data-dg="pt" cx="284" cy="54" r="1.9" fill="currentColor" fill-opacity="0.43" style="--k: 13"/>
  </g>
  {%- comment -%} the fundamental cell and the basis {%- endcomment %}
  <path class="dg-h dg-d" style="--t: 0.12" pathLength="1" d="M136 116L152 78L108 86"/>
  <g style="--t: 0.26">
    <path class="dg-k dg-d" pathLength="1" d="M92 124L133.6 116.4"/>
    <path class="dg-k dg-d" pathLength="1" d="M92 124L107.1 88.2" style="--k: 4"/>
  </g>
  <g style="--t: 0.5">
    <path class="dg-k dg-d" pathLength="1" d="M127.9 114.7L133.6 116.4L128.8 120"/>
    <path class="dg-k dg-d" pathLength="1" d="M102.5 92.1L107.1 88.2L107.5 94.2" style="--k: 4"/>
  </g>
  {%- comment -%} the error vector and the target {%- endcomment %}
  <line class="dg-k dg-d" data-dg="err" style="--t: 0.9" pathLength="1" x1="196" y1="70" x2="207" y2="79"/>
  <g data-dg="target" data-x="207" data-y="79">
    <g style="--t: 0.6">
      <path class="dg-k dg-d" pathLength="1" d="M203.6 75.6L210.4 82.4"/>
      <path class="dg-k dg-d" pathLength="1" d="M210.4 75.6L203.6 82.4" style="--k: 3"/>
    </g>
    {%- if include.detail == 'full' %}
    <text class="dg-sym dg-f" style="--t: 1" x="213.5" y="76">t</text>
    {%- endif %}
  </g>
  {%- if include.detail == 'full' %}
  <g class="dg-f" style="--t: 1">
    <text class="dg-sym" x="118" y="134">b<tspan class="dg-sub" dy="2.5">1</tspan></text>
    <text class="dg-sym" x="83" y="104" text-anchor="end">b<tspan class="dg-sub" dy="2.5">2</tspan></text>
  </g>
  {%- endif %}
</svg>
